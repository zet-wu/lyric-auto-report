{
  "song": "j14",
  "name": "j14 - Spica",
  "audio": "datasets/audio/j14 - Spica.m4a",
  "lines": [
    {
      "id": "j14-n441",
      "text": "眠りの時がきて"
    },
    {
      "id": "j14-n457",
      "text": "形さえいつか消えて"
    },
    {
      "id": "j14-n475",
      "text": "それでも 君がくれた"
    },
    {
      "id": "j14-n489",
      "text": "思いだけは残るでしょう"
    },
    {
      "id": "j14-n508",
      "text": "指先を握れば思い出す"
    },
    {
      "id": "j14-n538",
      "text": "永遠を誓ったその意味を"
    },
    {
      "id": "j14-n568",
      "text": "最後の風を見てた"
    },
    {
      "id": "j14-n591",
      "text": "高台の風車が止まる"
    },
    {
      "id": "j14-n619",
      "text": "これからどこにゆこう？"
    },
    {
      "id": "j14-n631",
      "text": "ひとり自分に聞いてみる"
    },
    {
      "id": "j14-n653",
      "text": "涙で滲んだ目でも"
    },
    {
      "id": "j14-n674",
      "text": "前に歩き出す強さが欲しい"
    },
    {
      "id": "j14-n705",
      "text": "いつか 終わる日は"
    },
    {
      "id": "j14-n720",
      "text": "優しい夢を見た"
    },
    {
      "id": "j14-n739",
      "text": "ずっと 抱きしめて"
    },
    {
      "id": "j14-n751",
      "text": "あげたかったそっと"
    },
    {
      "id": "j14-n761",
      "text": "世界が眠りにつく"
    },
    {
      "id": "j14-n781",
      "text": "そんな夕映えにも見えた"
    },
    {
      "id": "j14-n803",
      "text": "それでも 君がくれた"
    },
    {
      "id": "j14-n817",
      "text": "誓いだけは残るでしょう"
    },
    {
      "id": "j14-n836",
      "text": "朝は熱い紅茶を淹れて見た"
    },
    {
      "id": "j14-n870",
      "text": "眠ってばかりいた君に"
    },
    {
      "id": "j14-n889",
      "text": "いつか 終わる日は"
    },
    {
      "id": "j14-n904",
      "text": "優しい夢の中"
    },
    {
      "id": "j14-n923",
      "text": "ずっと 抱きしめて"
    },
    {
      "id": "j14-n935",
      "text": "ほしかったあの人に"
    },
    {
      "id": "j14-n949",
      "text": "いつか 終わる日は"
    },
    {
      "id": "j14-n964",
      "text": "優しい夢を見た"
    },
    {
      "id": "j14-n983",
      "text": "ずっと そばにいた"
    },
    {
      "id": "j14-n992",
      "text": "君の腕で泣いた"
    },
    {
      "id": "j14-n1011",
      "text": "どこへ ゆけるのか"
    },
    {
      "id": "j14-n1020",
      "text": "自分に聞いてみる"
    },
    {
      "id": "j14-n1039",
      "text": "ずっと 君といた"
    },
    {
      "id": "j14-n1051",
      "text": "この場所を忘れて"
    },
    {
      "id": "j14-n1070",
      "text": "どこへ"
    }
  ]
}
