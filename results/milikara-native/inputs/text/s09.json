{
  "song": "s09",
  "name": "恋のルチはや♡ローリング",
  "audio": "datasets/audio/恋のルチはや♡ローリング.m4a",
  "lines": [
    {
      "id": "s09-n605",
      "text": "この花 咲く夜の姫よ"
    },
    {
      "id": "s09-n629",
      "text": "悪い虫がつかぬよう"
    },
    {
      "id": "s09-n647",
      "text": "眼ギラギラ獲物狙う"
    },
    {
      "id": "s09-n673",
      "text": "狩猟者"
    },
    {
      "id": "s09-n687",
      "text": "目覚めの 合図は そっと"
    },
    {
      "id": "s09-n711",
      "text": "前触れなく訪れた"
    },
    {
      "id": "s09-n732",
      "text": "甘い 思考のヤツから"
    },
    {
      "id": "s09-n753",
      "text": "刈りつくそう"
    },
    {
      "id": "s09-n763",
      "text": "この程度の思いで挑むのなら"
    },
    {
      "id": "s09-n792",
      "text": "灼け落ちる前に"
    },
    {
      "id": "s09-n810",
      "text": "ここから去れ消えてしまえよ"
    },
    {
      "id": "s09-n830",
      "text": "覚悟なら胸に"
    },
    {
      "id": "s09-n848",
      "text": "刻んであるわ"
    },
    {
      "id": "s09-n859",
      "text": "投げた 白い手袋を拾え！"
    },
    {
      "id": "s09-n890",
      "text": "恋のローリング転がるように"
    },
    {
      "id": "s09-n912",
      "text": "堕ち往く"
    },
    {
      "id": "s09-n923",
      "text": "赤い糸さえ"
    },
    {
      "id": "s09-n937",
      "text": "結わすヒマないさ ゼ・ツ・ボ・ウ"
    },
    {
      "id": "s09-n953",
      "text": "狙いは十分"
    },
    {
      "id": "s09-n971",
      "text": "勝敗は時の運ね"
    },
    {
      "id": "s09-n995",
      "text": "誰もこの座は奪えない"
    },
    {
      "id": "s09-n1017",
      "text": "素直に 好きと言えたら"
    },
    {
      "id": "s09-n1041",
      "text": "誰もが うらやむ未来"
    },
    {
      "id": "s09-n1062",
      "text": "ゆけると信じているのかい？"
    },
    {
      "id": "s09-n1080",
      "text": "愚かさ"
    },
    {
      "id": "s09-n1088",
      "text": "ぬけがけ 恋の駆け引き"
    },
    {
      "id": "s09-n1109",
      "text": "出し抜け 疾風のように"
    },
    {
      "id": "s09-n1130",
      "text": "笑う 決闘者たちを"
    },
    {
      "id": "s09-n1148",
      "text": "狩りつくそう"
    },
    {
      "id": "s09-n1158",
      "text": "芽生えた 恋心守るためには"
    },
    {
      "id": "s09-n1190",
      "text": "恋敵すぐに"
    },
    {
      "id": "s09-n1205",
      "text": "蹴落とさなきゃ やられちゃうから"
    },
    {
      "id": "s09-n1225",
      "text": "貫く思い負ける気などない"
    },
    {
      "id": "s09-n1253",
      "text": "捨て身 挑むわテンミニッツ沈め！"
    },
    {
      "id": "s09-n1287",
      "text": "恋のローリング転がるように"
    },
    {
      "id": "s09-n1309",
      "text": "堕ち往く"
    },
    {
      "id": "s09-n1320",
      "text": "引き返せないと"
    },
    {
      "id": "s09-n1335",
      "text": "気付いたなら ソク！ ダ・ン・ザ・イ"
    },
    {
      "id": "s09-n1354",
      "text": "罪と罰の恋"
    },
    {
      "id": "s09-n1372",
      "text": "許されるのはいつなの？"
    },
    {
      "id": "s09-n1388",
      "text": "誰も行く末を知らない"
    },
    {
      "id": "s09-n1413",
      "text": "恋はローリング転がるように"
    },
    {
      "id": "s09-n1435",
      "text": "堕ち往く"
    },
    {
      "id": "s09-n1446",
      "text": "溺れてしまえと"
    },
    {
      "id": "s09-n1458",
      "text": "罪深きその カ・イ・カ・ン"
    },
    {
      "id": "s09-n1476",
      "text": "狙いは十分"
    },
    {
      "id": "s09-n1494",
      "text": "いまだ射程圏内さ"
    },
    {
      "id": "s09-n1518",
      "text": "誰もこの座を譲れない"
    }
  ]
}
