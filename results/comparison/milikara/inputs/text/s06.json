{
  "song": "s06",
  "name": "Worlds Pain",
  "audio": "datasets/audio/Worlds Pain.m4a",
  "lines": [
    {
      "id": "s06-n635",
      "text": "この空がなくした物語"
    },
    {
      "id": "s06-n659",
      "text": "いつか見たはずの"
    },
    {
      "id": "s06-n671",
      "text": "輝きを求め探した"
    },
    {
      "id": "s06-n693",
      "text": "雲の色いま"
    },
    {
      "id": "s06-n707",
      "text": "鉛のように重く"
    },
    {
      "id": "s06-n724",
      "text": "大地を傷つける"
    },
    {
      "id": "s06-n743",
      "text": "冷たい雨を降らせてた"
    },
    {
      "id": "s06-n765",
      "text": "閉ざされた未来を歩く"
    },
    {
      "id": "s06-n790",
      "text": "幼子の瞳の中に見た"
    },
    {
      "id": "s06-n820",
      "text": "小さな希望は"
    },
    {
      "id": "s06-n838",
      "text": "僕らを苛む罪のようで"
    },
    {
      "id": "s06-n862",
      "text": "この空がなくした物語"
    },
    {
      "id": "s06-n886",
      "text": "いつか見たはずの"
    },
    {
      "id": "s06-n898",
      "text": "輝きを求め探した"
    },
    {
      "id": "s06-n920",
      "text": "心だけ渇く世界を踏みしめ"
    },
    {
      "id": "s06-n952",
      "text": "ただその日を生きる"
    },
    {
      "id": "s06-n968",
      "text": "錆びた風浴び"
    },
    {
      "id": "s06-n985",
      "text": "呼吸さえも潜めた"
    },
    {
      "id": "s06-n1005",
      "text": "僕らはあてのない"
    },
    {
      "id": "s06-n1018",
      "text": "旅に出ることさえ出来ず"
    },
    {
      "id": "s06-n1043",
      "text": "明日は昨日よりも"
    },
    {
      "id": "s06-n1060",
      "text": "色褪せてゆく"
    },
    {
      "id": "s06-n1074",
      "text": "壊れた世界の姿"
    },
    {
      "id": "s06-n1098",
      "text": "誰が望んでた"
    },
    {
      "id": "s06-n1120",
      "text": "あの空の向こうに行くことが"
    },
    {
      "id": "s06-n1144",
      "text": "できたとしたなら"
    },
    {
      "id": "s06-n1153",
      "text": "取り戻せるのか知りたい"
    },
    {
      "id": "s06-n1175",
      "text": "在りし日の道標求める手の中"
    },
    {
      "id": "s06-n1210",
      "text": "小さな光握り締めてた"
    },
    {
      "id": "s06-n1237",
      "text": "受け継がれる記憶"
    },
    {
      "id": "s06-n1259",
      "text": "語り継ぐ言葉"
    },
    {
      "id": "s06-n1280",
      "text": "長い旅路に"
    },
    {
      "id": "s06-n1297",
      "text": "小さな心を抱いて"
    },
    {
      "id": "s06-n1318",
      "text": "蒼穹の境界"
    },
    {
      "id": "s06-n1340",
      "text": "大気の果てへ"
    },
    {
      "id": "s06-n1357",
      "text": "星の声を"
    },
    {
      "id": "s06-n1382",
      "text": "いつか届けるのだと"
    },
    {
      "id": "s06-n1396",
      "text": "この空がなくした物語"
    },
    {
      "id": "s06-n1420",
      "text": "いつか見たはずの"
    },
    {
      "id": "s06-n1432",
      "text": "輝きを求め探した"
    },
    {
      "id": "s06-n1454",
      "text": "在りし日の道標求める手の中"
    },
    {
      "id": "s06-n1489",
      "text": "小さな光握り締めてた"
    },
    {
      "id": "s06-n1516",
      "text": "あの空がなくした物語"
    },
    {
      "id": "s06-n1540",
      "text": "いつか見たはずの"
    },
    {
      "id": "s06-n1552",
      "text": "優しさを求め探した"
    },
    {
      "id": "s06-n1574",
      "text": "あの澄んだ青い世界の欠片よ"
    },
    {
      "id": "s06-n1606",
      "text": "君の元へ届け"
    }
  ]
}
