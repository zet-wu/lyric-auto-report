{
  "song": "s01",
  "name": "003 - 撃槍・ガングニール",
  "audio": "datasets/audio/003 - 撃槍・ガングニール.m4a",
  "lines": [
    {
      "id": "s01-n590",
      "text": "絶対に…離さない"
    },
    {
      "id": "s01-n611",
      "text": "この繋いだ手は"
    },
    {
      "id": "s01-n626",
      "text": "こんなにほら暖かいんだ"
    },
    {
      "id": "s01-n643",
      "text": "ヒトの作る温もりは"
    },
    {
      "id": "s01-n661",
      "text": "難しい言葉なんていらないよ"
    },
    {
      "id": "s01-n687",
      "text": "今わかる共鳴する Brave minds"
    },
    {
      "id": "s01-n710",
      "text": "ぐっとぐっとみなぎってく"
    },
    {
      "id": "s01-n723",
      "text": "止めどなく溢れていく"
    },
    {
      "id": "s01-n741",
      "text": "紡ぎ合いたい魂"
    },
    {
      "id": "s01-n762",
      "text": "100万の気持ち…さぁ"
    },
    {
      "id": "s01-n786",
      "text": "ぶっ飛べこのエナジーよ"
    },
    {
      "id": "s01-n801",
      "text": "解放全開！イっちゃえ Heart のゼンブで"
    },
    {
      "id": "s01-n838",
      "text": "進む事以外答えなんてあるわけがない"
    },
    {
      "id": "s01-n875",
      "text": "見つけたんだよ"
    },
    {
      "id": "s01-n886",
      "text": "心の帰る場所"
    },
    {
      "id": "s01-n908",
      "text": "Yes 届け！全身全霊この想いよ"
    },
    {
      "id": "s01-n946",
      "text": "響け！胸の鼓動！未来の先へ…"
    },
    {
      "id": "s01-n987",
      "text": "真っすぐに…みつめる"
    },
    {
      "id": "s01-n1001",
      "text": "事が出来なくて"
    },
    {
      "id": "s01-n1019",
      "text": "ポケットへとしまいこんだ"
    },
    {
      "id": "s01-n1032",
      "text": "いい訳みたいな笑顔"
    },
    {
      "id": "s01-n1053",
      "text": "「一歩ずつ一歩ずつちょっとだって…」"
    },
    {
      "id": "s01-n1084",
      "text": "Ah 伝う信じる明日 Brave song"
    },
    {
      "id": "s01-n1106",
      "text": "きっときっと叶うはずさ"
    },
    {
      "id": "s01-n1122",
      "text": "不可能なんてないはずさ"
    },
    {
      "id": "s01-n1144",
      "text": "戦うことを恐れず"
    },
    {
      "id": "s01-n1162",
      "text": "でっかぃ気持ち…さぁ"
    },
    {
      "id": "s01-n1179",
      "text": "ぶっ込めこのエナジーを"
    },
    {
      "id": "s01-n1194",
      "text": "100パー全開！握った夢をぶつけよう"
    },
    {
      "id": "s01-n1231",
      "text": "涙なんて流している暇はないから"
    },
    {
      "id": "s01-n1260",
      "text": "守るべきモノ"
    },
    {
      "id": "s01-n1271",
      "text": "私にはあるんだ"
    },
    {
      "id": "s01-n1284",
      "text": "Yes 焦がせ！煌めいた生命のフレア"
    },
    {
      "id": "s01-n1311",
      "text": "解放全開！イっちゃえHeartのゼンブで"
    },
    {
      "id": "s01-n1348",
      "text": "進む事以外答えなんてあるわけがない"
    },
    {
      "id": "s01-n1385",
      "text": "見つけたんだよ"
    },
    {
      "id": "s01-n1396",
      "text": "心の帰る場所"
    },
    {
      "id": "s01-n1418",
      "text": "Yes届け！全身全霊この想いよ"
    },
    {
      "id": "s01-n1456",
