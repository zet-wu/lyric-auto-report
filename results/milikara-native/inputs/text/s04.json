{
  "song": "s04",
  "name": "TSU-BA-SA",
  "audio": "datasets/audio/TSU-BA-SA.m4a",
  "lines": [
    {
      "id": "s04-n497",
      "text": "僕達は いつかまた"
    },
    {
      "id": "s04-n514",
      "text": "あの場所に還るよ"
    },
    {
      "id": "s04-n533",
      "text": "長く長く続いてく"
    },
    {
      "id": "s04-n554",
      "text": "道の先には"
    },
    {
      "id": "s04-n568",
      "text": "夢にまで見た景色が"
    },
    {
      "id": "s04-n592",
      "text": "揺れるイメージ"
    },
    {
      "id": "s04-n603",
      "text": "だけど何だかこの日に限って"
    },
    {
      "id": "s04-n628",
      "text": "不安が邪魔をする 刹那"
    },
    {
      "id": "s04-n659",
      "text": "心がふわり風に舞う fly away"
    },
    {
      "id": "s04-n684",
      "text": "僕達は いつかまた"
    },
    {
      "id": "s04-n701",
      "text": "あの場所に還るよ"
    },
    {
      "id": "s04-n720",
      "text": "少女の涙が導く真理"
    },
    {
      "id": "s04-n754",
      "text": "今はまだ この道は"
    },
    {
      "id": "s04-n771",
      "text": "希望の途中にある"
    },
    {
      "id": "s04-n794",
      "text": "目を閉じたままで"
    },
    {
      "id": "s04-n809",
      "text": "描く 明日の奇跡"
    },
    {
      "id": "s04-n832",
      "text": "長く長く果てしない"
    },
    {
      "id": "s04-n853",
      "text": "国道ぬけて"
    },
    {
      "id": "s04-n867",
      "text": "眩しいほどの世界へ"
    },
    {
      "id": "s04-n888",
      "text": "飛び込んで行く"
    },
    {
      "id": "s04-n905",
      "text": "遠い記憶の彼方に"
    },
    {
      "id": "s04-n929",
      "text": "浮かんでは消える少女の 夢が"
    },
    {
      "id": "s04-n960",
      "text": "心にふわり一つへと fly away"
    },
    {
      "id": "s04-n982",
      "text": "僕達が 大空に"
    },
    {
      "id": "s04-n1005",
      "text": "約束をした朝"
    },
    {
      "id": "s04-n1024",
      "text": "鳥のざわめきが"
    },
    {
      "id": "s04-n1036",
      "text": "未来を嘆く"
    },
    {
      "id": "s04-n1053",
      "text": "そんな事 わかってる"
    },
    {
      "id": "s04-n1067",
      "text": "深く沈んだ記憶"
    },
    {
      "id": "s04-n1090",
      "text": "もう独りじゃない"
    },
    {
      "id": "s04-n1102",
      "text": "いのち 明日へ繋ぐ"
    },
    {
      "id": "s04-n1119",
      "text": "心にふわり届けたい fly away"
    },
    {
      "id": "s04-n1141",
      "text": "僕はただ 君の夢"
    },
    {
      "id": "s04-n1161",
      "text": "追いかけて走った"
    },
    {
      "id": "s04-n1177",
      "text": "誰もが信じた"
    },
    {
      "id": "s04-n1192",
      "text": "愛の行方を"
    },
    {
      "id": "s04-n1206",
      "text": "今はまだ この道は"
    },
    {
      "id": "s04-n1223",
      "text": "希望の途中にある"
    },
    {
      "id": "s04-n1246",
      "text": "目を閉じたままで"
    },
    {
      "id": "s04-n1261",
      "text": "描く 明日の奇跡"
    }
  ]
}
