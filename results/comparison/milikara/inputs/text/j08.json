{
  "song": "j08",
  "name": "j08 - 光陰の海原",
  "audio": "datasets/audio/j08 - 光陰の海原.m4a",
  "lines": [
    {
      "id": "j08-n3",
      "text": "夜空見上げてここに居てもいいのに"
    },
    {
      "id": "j08-n36",
      "text": "星が瞬き暗い過去が消えてく"
    },
    {
      "id": "j08-n72",
      "text": "光る未来を目指して手を取り合う"
    },
    {
      "id": "j08-n114",
      "text": "今に始まりそうな期待感じてる"
    },
    {
      "id": "j08-n148",
      "text": "沢山の夢を持つのは素敵と"
    },
    {
      "id": "j08-n183",
      "text": "口ずさむ言葉キミとの思い出"
    },
    {
      "id": "j08-n215",
      "text": "扉開けて前を向いて歩くと"
    },
    {
      "id": "j08-n247",
      "text": "金色の砂浜光る風の海原"
    },
    {
      "id": "j08-n288",
      "text": "子供の頃見たプレゼントの様にと"
    },
    {
      "id": "j08-n322",
      "text": "はしゃぐ笑顔のキミを見つめ微笑む"
    },
    {
      "id": "j08-n352",
      "text": "ほどくリボン夢ほどくのはこれから"
    },
    {
      "id": "j08-n373",
      "text": "手を合わせ光るゴールテーブ切ろう"
    },
    {
      "id": "j08-n412",
      "text": "キラキラと 降り注ぐ"
    },
    {
      "id": "j08-n429",
      "text": "宝物 手に集め"
    },
    {
      "id": "j08-n452",
      "text": "広げると 溢れ出す 光の中で"
    },
    {
      "id": "j08-n485",
      "text": "夜空見上げてここに居てもいいのに"
    },
