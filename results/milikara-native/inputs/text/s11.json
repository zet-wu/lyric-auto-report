{
  "song": "s11",
  "name": "星 (鄧麗君演唱會1982 live)",
  "audio": "datasets/audio/星 (鄧麗君演唱會1982 live).m4a",
  "lines": [
    {
      "id": "s11-n28",
      "text": "目を閉じて何も見えず"
    },
    {
      "id": "s11-n52",
      "text": "哀しくて目を開ければ"
    },
    {
      "id": "s11-n73",
      "text": "荒野に向かう道より"
    },
    {
      "id": "s11-n97",
      "text": "他に見えるものはなし"
    },
    {
      "id": "s11-n115",
      "text": "ああ 砕け散る"
    },
    {
      "id": "s11-n129",
      "text": "宿命の星たちよ"
    },
    {
      "id": "s11-n145",
      "text": "せめて鮮やかに"
    },
    {
      "id": "s11-n157",
      "text": "この身を照せよ"
    },
    {
      "id": "s11-n172",
      "text": "我は行く 蒼白き頬のままで"
    },
    {
      "id": "s11-n204",
      "text": "我は行く さらば昴よ"
    },
    {
      "id": "s11-n226",
      "text": "踏过荆棘 苦中找到安静"
    },
    {
      "id": "s11-n237",
      "text": "踏过荒郊 我双脚是泥泞"
    },
    {
      "id": "s11-n248",
      "text": "满天星光 我不怕风正劲"
    },
    {
      "id": "s11-n259",
      "text": "满心是期望 过黑暗是黎明"
    },
    {
      "id": "s11-n271",
      "text": "啊 星也灿烂 伴我夜行给我影"
    },
    {
      "id": "s11-n284",
      "text": "啊 星光引路 风之语轻轻听"
    },
    {
      "id": "s11-n296",
      "text": "带着热情 我要找理想 理想是和平"
    },
    {
      "id": "s11-n311",
      "text": "寻梦而去 哪怕走崎岖险径"
    },
    {
      "id": "s11-n323",
      "text": "啊 星也灿烂 伴我夜行给我影"
    },
    {
      "id": "s11-n336",
      "text": "啊 星光引路 风之语轻轻听"
    },
    {
      "id": "s11-n348",
      "text": "带着热情 我要找理想 理想是和平"
    },
    {
      "id": "s11-n363",
      "text": "寻梦而去 哪怕走崎岖险径"
    },
    {
      "id": "s11-n375",
      "text": "明日谁步过 这星也带领"
    }
  ]
}
