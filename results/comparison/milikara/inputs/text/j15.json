{
  "song": "j15",
  "name": "j15 - Spica (new arrange)",
  "audio": "datasets/audio/j15 - Spica (new arrange).m4a",
  "lines": [
    {
      "id": "j15-n443",
      "text": "眠りの時がきて"
    },
    {
      "id": "j15-n459",
      "text": "形さえいつか消えて"
    },
    {
      "id": "j15-n477",
      "text": "それでも 君がくれた"
    },
    {
      "id": "j15-n491",
      "text": "思いだけは残るでしょう"
    },
    {
      "id": "j15-n510",
      "text": "指先を握れば思い出す"
    },
    {
      "id": "j15-n540",
      "text": "永遠を誓ったその意味を"
    },
    {
      "id": "j15-n570",
      "text": "最後の風を見てた"
    },
    {
      "id": "j15-n593",
      "text": "高台の風車が止まる"
    },
    {
      "id": "j15-n621",
      "text": "これからどこにゆこう？"
    },
    {
      "id": "j15-n633",
      "text": "ひとり自分に聞いてみる"
    },
    {
      "id": "j15-n655",
      "text": "涙で滲んだ目でも"
    },
    {
      "id": "j15-n676",
      "text": "前に歩き出す強さが欲しい"
    },
    {
      "id": "j15-n707",
      "text": "いつか 終わる日は"
    },
    {
      "id": "j15-n722",
      "text": "優しい夢を見た"
    },
    {
      "id": "j15-n741",
      "text": "ずっと 抱きしめて"
    },
    {
      "id": "j15-n753",
      "text": "あげたかったそっと"
    },
    {
      "id": "j15-n763",
      "text": "世界が眠りにつく"
    },
    {
      "id": "j15-n783",
      "text": "そんな夕映えにも見えた"
    },
    {
      "id": "j15-n805",
      "text": "それでも 君がくれた"
    },
    {
      "id": "j15-n819",
      "text": "誓いだけは残るでしょう"
    },
    {
      "id": "j15-n838",
      "text": "朝は熱い紅茶を淹れて見た"
    },
    {
      "id": "j15-n872",
      "text": "眠ってばかりいた君に"
    },
    {
      "id": "j15-n891",
      "text": "いつか 終わる日は"
    },
    {
      "id": "j15-n906",
      "text": "優しい夢の中"
    },
    {
      "id": "j15-n925",
      "text": "ずっと 抱きしめて"
    },
    {
      "id": "j15-n937",
      "text": "ほしかったあの人に"
    },
    {
      "id": "j15-n951",
      "text": "いつか 終わる日は"
    },
    {
      "id": "j15-n966",
      "text": "優しい夢を見た"
    },
    {
      "id": "j15-n985",
      "text": "ずっと そばにいた"
    },
    {
      "id": "j15-n994",
      "text": "君の腕で泣いた"
    },
    {
      "id": "j15-n1020",
      "text": "どこへ ゆけるのか"
    },
    {
      "id": "j15-n1029",
      "text": "自分に聞いてみる"
    },
    {
      "id": "j15-n1048",
      "text": "ずっと 君といた"
    },
    {
      "id": "j15-n1060",
      "text": "この場所を忘れて"
    },
    {
      "id": "j15-n1079",
      "text": "どこへ"
    }
  ]
}
