{
  "song": "s15",
  "name": "036 - リトルミラクル -Grip it tight-",
  "audio": "datasets/audio/036 - リトルミラクル -Grip it tight-.m4a",
  "lines": [
    {
      "id": "s15-n90",
      "text": "奇跡が宿った機械仕掛けの"
    },
    {
      "id": "s15-n127",
      "text": "このアームには意味がある"
    },
    {
      "id": "s15-n158",
      "text": "普通の日常なんでもない日々"
    },
    {
      "id": "s15-n193",
      "text": "そんな夢の為だと"
    },
    {
      "id": "s15-n223",
      "text": "温もりを伝える"
    },
    {
      "id": "s15-n255",
      "text": "言葉じゃなくたって"
    },
    {
      "id": "s15-n286",
      "text": "この拳の答え"
    },
    {
      "id": "s15-n302",
      "text": "武器を持たぬ答え"
    },
    {
      "id": "s15-n324",
      "text": "「一撃必愛」ぶっ込めラブソング"
    },
    {
      "id": "s15-n362",
      "text": "正義を信じ握りしめよう"
    },
    {
      "id": "s15-n416",
      "text": "やり直せばいい 壊れたって"
    },
    {
      "id": "s15-n437",
      "text": "もうへいきへっちゃら"
    },
    {
      "id": "s15-n455",
      "text": "ハート響かせ合い"
    },
    {
      "id": "s15-n471",
      "text": "なけなしの勇気だって「勇気」"
    },
    {
      "id": "s15-n500",
      "text": "泣けるほどギュッと 愛になる"
    },
    {
      "id": "s15-n520",
      "text": "託されたかった…抱いて欲しかった…"
    },
    {
      "id": "s15-n547",
      "text": "おっきな手で褒められたくて…"
    },
    {
      "id": "s15-n583",
      "text": "強くあって欲しい…そんな本音を"
    },
    {
      "id": "s15-n612",
      "text": "ガムシャラに打つけてた"
    },
    {
      "id": "s15-n636",
      "text": "いつだって貰っていた"
    },
    {
      "id": "s15-n666",
      "text": "あったかい大切なもの"
    },
    {
      "id": "s15-n703",
      "text": "負けるなと言ってる"
    },
    {
      "id": "s15-n719",
      "text": "受け取れと言ってる"
    },
    {
      "id": "s15-n738",
      "text": "胸を焦がす最愛のラブコール"
    },
    {
      "id": "s15-n770",
      "text": "そう簡単に離しはしない"
    },
    {
      "id": "s15-n818",
      "text": "それが私の見つけた道"
    },
    {
      "id": "s15-n840",
      "text": "傷つけ傷ついて"
    },
    {
      "id": "s15-n870",
      "text": "磨いた絆なら"
    },
    {
      "id": "s15-n886",
      "text": "どんなものより煌めくさ"
    },
    {
      "id": "s15-n902",
      "text": "私はまた立つ…! 明日へと"
    },
    {
      "id": "s15-n926",
      "text": "此れから此処から始まる"
    },
    {
      "id": "s15-n951",
      "text": "全霊で歌おう"
    },
    {
      "id": "s15-n970",
      "text": "愛は響く 強く響く"
    },
    {
      "id": "s15-n995",
      "text": "握った分 繋いだ分"
    },
    {
      "id": "s15-n1020",
      "text": "言葉がなくたって"
    },
    {
      "id": "s15-n1036",
      "text": "言葉じゃなくたって"
    },
    {
      "id": "s15-n1052",
      "text": "心へと 空へと"
    },
    {
      "id": "s15-n1068",
      "text": "この想いよ…!"
    },
    {
      "id": "s15-n1079",
      "text": "正義を信じ握りしめよう"
    },
    {
      "id": "s15-n1133",
      "text": "やり直せばいい 壊れたって"
    },
    {
      "id": "s15-n1154",
      "text": "もうへいきへっちゃら"
    },
    {
      "id": "s15-n1172",
      "text": "ハート響かせ合い"
    },
    {
      "id": "s15-n1187",
      "text": "なけなしの勇気だって「勇気」"
    },
    {
      "id": "s15-n1216",
      "text": "泣けるほどギュッと 愛になる"
    }
  ]
}
