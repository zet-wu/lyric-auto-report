{
  "song": "j17",
  "name": "j17 - 一万の軌跡",
  "audio": "datasets/audio/j17 - 一万の軌跡.m4a",
  "lines": [
    {
      "id": "j17-n662",
      "text": "足さえ竦むような"
    },
    {
      "id": "j17-n679",
      "text": "断崖に立って"
    },
    {
      "id": "j17-n697",
      "text": "闇を見下ろしていた"
    },
    {
      "id": "j17-n717",
      "text": "無数の光たち"
    },
    {
      "id": "j17-n736",
      "text": "流星のように落ちては消えた"
    },
    {
      "id": "j17-n764",
      "text": "今なら届くかもしれない"
    },
    {
      "id": "j17-n784",
      "text": "手を伸ばせば でも"
    },
    {
      "id": "j17-n799",
      "text": "そんなことできない"
    },
    {
      "id": "j17-n809",
      "text": "もう僕は見送るだけ"
    },
    {
      "id": "j17-n830",
      "text": "一万の軌跡を"
    },
    {
      "id": "j17-n852",
      "text": "強がりははなせない"
    },
    {
      "id": "j17-n866",
      "text": "臆病なその足で進んで行く"
    },
    {
      "id": "j17-n898",
      "text": "歯がゆさで"
    },
    {
      "id": "j17-n907",
      "text": "悔しさで"
    },
    {
      "id": "j17-n916",
      "text": "向かって行く"
    },
    {
      "id": "j17-n929",
      "text": "それが人だから"
    },
    {
      "id": "j17-n941",
      "text": "60億分の思いが"
    },
    {
      "id": "j17-n967",
      "text": "織り成す別世界が目の前に"
    },
    {
      "id": "j17-n1004",
      "text": "僕らを包んでゆくんだ"
    },
    {
      "id": "j17-n1023",
      "text": "聞こえてくる声は…"
    },
    {
      "id": "j17-n1040",
      "text": "生きて行くことが醜くても"
    },
    {
      "id": "j17-n1084",
      "text": "生きて行くことで守ってゆく"
    },
    {
      "id": "j17-n1128",
      "text": "生きて行くことが醜くても"
    },
    {
      "id": "j17-n1172",
      "text": "生きて行くことで輝き出す"
    },
    {
      "id": "j17-n1219",
      "text": "飛鳥が舞いて"
    },
    {
      "id": "j17-n1236",
      "text": "飛鳥が降りる"
    },
    {
      "id": "j17-n1253",
      "text": "古の道に..."
    },
    {
      "id": "j17-n1269",
      "text": "旅の記憶はもう…"
    },
    {
      "id": "j17-n1289",
      "text": "遠い岸辺の朝"
    },
    {
      "id": "j17-n1311",
      "text": "今、君に捧げる"
    },
    {
      "id": "j17-n1331",
      "text": "強がりははなせない"
    },
    {
      "id": "j17-n1345",
      "text": "臆病なその足で進んで行け"
    },
    {
      "id": "j17-n1377",
      "text": "傷ついて"
    },
    {
      "id": "j17-n1386",
      "text": "雨に打たれ"
    },
    {
      "id": "j17-n1399",
      "text": "向かって行く"
    },
    {
      "id": "j17-n1412",
      "text": "それが人だから"
    },
    {
      "id": "j17-n1424",
      "text": "60億分の思いが"
    },
    {
      "id": "j17-n1450",
      "text": "織り成す別世界が目の前に"
    },
    {
      "id": "j17-n1487",
      "text": "僕らをつつんでゆくんだ"
    },
    {
      "id": "j17-n1503",
      "text": "聞こえてくる声は…"
    },
    {
      "id": "j17-n1520",
      "text": "生きて行くことが醜くても"
    },
    {
      "id": "j17-n1564",
      "text": "生きて行くことで守ってゆく"
    },
    {
      "id": "j17-n1608",
      "text": "生きて行くことが醜くても"
    },
    {
      "id": "j17-n1652",
      "text": "生きて行く…"
    }
  ]
}
