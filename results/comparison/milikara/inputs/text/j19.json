{
  "song": "j19",
  "name": "j19 - 花火",
  "audio": "datasets/audio/j19 - 花火.m4a",
  "lines": [
    {
      "id": "j19-n678",
      "text": "生命 儚くて"
    },
    {
      "id": "j19-n693",
      "text": "どうせ散り行く運命なら"
    },
    {
      "id": "j19-n715",
      "text": "人は幻をその胸に抱き"
    },
    {
      "id": "j19-n744",
      "text": "思い出をその背に抱え"
    },
    {
      "id": "j19-n769",
      "text": "歩くという"
    },
    {
      "id": "j19-n779",
      "text": "千里 万里の道"
    },
    {
      "id": "j19-n804",
      "text": "行く末は果てしなく"
    },
    {
      "id": "j19-n824",
      "text": "そのうちに静かな海に"
    },
    {
      "id": "j19-n843",
      "text": "飲み込まれていく"
    },
    {
      "id": "j19-n858",
      "text": "チリチリリと燃え盛る"
    },
    {
      "id": "j19-n876",
      "text": "鼓動の激しさを抑え"
    },
    {
      "id": "j19-n901",
      "text": "幾夜 幾千の星すら"
    },
    {
      "id": "j19-n929",
      "text": "打ち抜いて消し去って"
    },
    {
      "id": "j19-n952",
      "text": "生命 儚くて"
    },
    {
      "id": "j19-n967",
      "text": "どうせ散り行く運命なら"
    },
    {
      "id": "j19-n989",
      "text": "今 この躯体"
    },
    {
      "id": "j19-n1003",
      "text": "丸ごと賭けてみるまで"
    },
    {
      "id": "j19-n1021",
      "text": "生命 頑なに"
    },
    {
      "id": "j19-n1036",
      "text": "勝負を神が決めるなら"
    },
    {
      "id": "j19-n1061",
      "text": "その神の涙すら糧にして"
    },
    {
      "id": "j19-n1086",
      "text": "大輪の花を咲かせるだけ"
    },
    {
      "id": "j19-n1113",
      "text": "未知を切り開き"
    },
    {
      "id": "j19-n1134",
      "text": "一歩ずつ歩きだす"
    },
    {
      "id": "j19-n1154",
      "text": "抗えぬ明日に"
    },
    {
      "id": "j19-n1169",
      "text": "立ち向かう"
    },
    {
      "id": "j19-n1181",
      "text": "その意志を持って"
    },
    {
      "id": "j19-n1199",
      "text": "サラサララと はためいた"
    },
    {
      "id": "j19-n1211",
      "text": "震える髪を 結いつけて"
    },
    {
      "id": "j19-n1233",
      "text": "この心にこだまするは"
    },
    {
      "id": "j19-n1249",
      "text": "詠み人知らずの声"
    },
    {
      "id": "j19-n1272",
      "text": "希望 ゆかしくて"
    },
    {
      "id": "j19-n1284",
      "text": "この腕に託してみたい"
    },
    {
      "id": "j19-n1303",
      "text": "藍 交われば"
    },
    {
      "id": "j19-n1317",
      "text": "少しずつ藍に染まる"
    },
    {
      "id": "j19-n1338",
      "text": "涙 一筋が"
    },
    {
      "id": "j19-n1356",
      "text": "頬を伝っていくとしても"
    },
    {
      "id": "j19-n1376",
      "text": "最後の最期に生命輝け"
    },
    {
      "id": "j19-n1410",
      "text": "その雫 大地に届くまで"
    },
    {
      "id": "j19-n1437",
      "text": "チリチリリと燃え盛る"
    },
    {
      "id": "j19-n1455",
      "text": "鼓動の激しさを抑え"
    },
    {
      "id": "j19-n1480",
      "text": "幾夜 幾千の星すら"
    },
    {
      "id": "j19-n1508",
      "text": "打ち抜いて消し去って"
    },
    {
