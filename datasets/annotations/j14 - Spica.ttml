341" end="04:18.949">de </span><span begin="04:18.949" end="04:19.374">de </span><span begin="04:19.374" end="04:19.846">na </span><span begin="04:19.846" end="04:20.050">i </span><span begin="04:20.050" end="04:22.921">ta</span></text><text for="line-4f80d1af-06cc-44f6-b1d6-009ea44466a4"><span begin="04:22.921" end="04:23.545">do </span><span begin="04:23.545" end="04:24.241">ko </span><span begin="04:24.241" end="04:27.441">e </span><span begin="04:27.710" end="04:28.122">yu </span><span begin="04:28.122" end="04:29.657">ke </span><span begin="04:29.657" end="04:29.776">ru </span><span begin="04:29.776" end="04:29.921">no </span><span begin="04:29.921" end="04:30.741">ka </span></text><text for="line-07716b10-ab79-4004-a005-f2d3538ce307"><span begin="04:31.000" end="04:31.241">ji </span><span begin="04:31.241" end="04:31.461">bu </span><span begin="04:31.461" end="04:31.661">n </span><span begin="04:31.661" end="04:32.269">ni </span><span begin="04:32.360" end="04:33.000">ki </span><span begin="04:33.000" end="04:33.381">i </span><span begin="04:33.381" end="04:33.850">te </span><span begin="04:33.850" end="04:34.101">mi </span><span begin="04:34.101" end="04:36.461">ru</span></text><text for="line-5d560899-a92d-4cfb-9f48-1186f1106209"><span begin="04:36.881" end="04:37.581">zu </span><span begin="04:37.581" end="04:38.133">t </span><span begin="04:38.133" end="04:41.361">to </span><span begin="04:41.684" end="04:42.161">ki </span><span begin="04:42.161" end="04:43.661">mi </span><span begin="04:43.661" end="04:43.794">to </span><span begin="04:43.794" end="04:43.981">i </span><span begin="04:43.981" end="04:44.801">ta</span></text><text for="line-103b99e0-27be-4e9d-b826-e67286fc8fe8"><span begin="04:45.036" end="04:45.255">ko </span><span begin="04:45.255" end="04:45.455">no </span><span begin="04:45.455" end="04:45.661">ba </span><span begin="04:45.661" end="04:46.335">sho </span><span begin="04:46.335" end="04:46.958">wo </span><span begin="04:46.958" end="04:47.381">wa </span><span begin="04:47.381" end="04:47.837">su </span><span begin="04:47.837" end="04:48.055">re </span><span begin="04:48.055" end="04:50.541">te</span></text><text for="line-204cbf4f-1071-40b3-bd9e-ad8d7a1f3344"><span begin="04:50.921" end="04:51.582">do </span><span begin="04:51.582" end="04:52.272">ko </span><span begin="04:52.272" end="04:58.361">e</span></text></transliteration></transliterations><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="line-74b80e53-a035-43ce-80de-0d7d8d2d5b70">沉眠的时刻来临</text><text for="line-7f869619-a8cc-49ef-a6c1-996afc0138b3">形体总有一天也将消散</text><text for="line-55badc97-3897-4fa8-ba16-fc22bc156d68">即便如此 唯独你所给予的</text><text for="line-60f842f0-1323-4218-9cd4-3874f4fbdb53">思念也会留存吧</text><text for="line-5d38c2ec-795b-4cdf-97ce-93daad16593c">只要握住指尖便会想起</text><text for="line-147cfb00-f4ec-4c1d-b41d-068068c6428b">立下永恒誓言的那个意义</text><text for="line-204a3fa2-647a-433f-8169-61567d03de65">曾望着最后的风</text><text for="line-7b6c5cba-48cf-4eee-b6da-ddece4a9139d">高地上的风车停下了</text><text for="line-5d6edc44-17fd-4753-aa78-a1d3da29c04b">从今以后将前往何方？</text><text for="line-7c96a592-f978-46e6-b8d2-7596448e5d88">独自试着问问自己</text><text for="line-d5293646-4cf1-4205-acf1-b0389309a3fc">即便双眼被泪水模糊</text><text for="line-14cc0ab8-da55-4ac4-b742-fefda1974dc5">也渴望着向前迈出脚步的坚强</text><text for="line-4da87773-7b8e-45a1-9c94-7fd4be51b158">终有一天 在终结之日</text><text for="line-60b2ba35-cb6c-4e24-9520-5aac0cdd7803">会梦见温柔的梦</text><text for="line-c08326b6-6f06-41e4-a685-598f52f09d83">一直 紧紧抱住</text><text for="line-8baf9419-8b94-405d-9f3c-e6ca38209c95">曾想如此轻轻地对你</text><text for="line-95f4fab9-4a7c-4870-8b88-e11959918d8a">世界陷入沉眠</text><text for="line-87fdfa2e-6443-4f97-bc23-176d12f18c37">像是曾经见过的晚霞</text><text for="line-39d0b6d2-8b8b-4081-95f4-3cca5d091f69">即便如此 唯独你所给予的</text><text for="line-f63377d1-3dbf-4ce0-b092-61f616b88d4d">誓言也会留存吧</text><text for="line-5115991c-783b-444c-be2c-2789d729f0bd">清晨试着泡了热红茶</text><text for="line-b67b8f55-da74-484e-9cc5-82f84cb17501">给总是沉睡着的你</text><text for="line-dd3f01ff-aeb4-4ce3-acfb-cbccf7cdcd1d">终有一天 在终结之日</text><text for="line-16a46471-b456-46fb-81c3-7bba4980bb5f">温柔的梦境之中</text><text for="line-9d6afe39-2645-4639-92c4-a2875f2fe801">一直 紧紧抱住</text><text for="line-2ebe54f0-1166-427a-b779-30bac3d1dd42">曾盼望那个人如此对我</text><text for="line-b18c6928-ca94-45cd-95ab-e138416521ab">终有一天 在终结之日</text><text for="line-8eaac167-3edb-4296-824b-1b468753b22c">会梦见温柔的梦</text><text for="line-141030c4-50fd-403a-a6ec-4130708261e7">曾在一直陪在身旁的</text><text for="line-e1171ab1-9e04-4965-a776-a5dcb584f925">你的臂弯中哭泣过</text><text for="line-4f80d1af-06cc-44f6-b1d6-009ea44466a4">能去往何方呢</text><text for="line-07716b10-ab79-4004-a005-f2d3538ce307">试着问问自己</text><text for="line-5d560899-a92d-4cfb-9f48-1186f1106209">一直与你同在的</text><text for="line-103b99e0-27be-4e9d-b826-e67286fc8fe8">这个地方也会忘记</text><text for="line-204cbf4f-1071-40b3-bd9e-ad8d7a1f3344">向着何方</text></translation></translations></iTunesMetadata></metadata></head><body dur="04:58.361"><div><p xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xml:id="line-74b80e53-a035-43ce-80de-0d7d8d2d5b70" itunes:key="line-74b80e53-a035-43ce-80de-0d7d8d2d5b70" begin="00:25.435" end="00:30.882" ttm:agent="v1"><span begin="00:25.435" end="00:25.958" tts:ruby="container"><span tts:ruby="base">眠</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:25.435" end="00:25.730">ね</span><span tts:ruby="text" begin="00:25.730" end="00:25.958">む</span></span></span><span begin="00:25.958" end="00:26.188">り</span><span begin="00:26.188" end="00:27.484">の</span><span begin="00:27.484" end="00:27.961" tts:ruby="container"><span tts:ruby="base">時</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:27.484" end="00:27.719">と</span><span tts:ruby="text" begin="00:27.719" end="00:27.961">き</span></span></span><span begin="00:27.961" end="00:29.440">が</span><span begin="00:29.440" end="00:29.698">き</span><span begin="00:29.698" end="00:30.882">て</span></p><p xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xml:id="line-7f869619-a8cc-49ef-a6c1-996afc0138b3" itunes:key="line-7f869619-a8cc-49ef-a6c1-996afc0138b3" begin="00:31.155" end="00:38.575" ttm:agent="v1"><span begin="00:31.184" end="00:32.860" tts:ruby="container"><span tts:ruby="base">形</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:31.184" end="00:31.654">か</span><span tts:ruby="text" begin="00:31.654" end="00:32.269">た</span><span tts:ruby="text" begin="00:32.269" end="00:32.860">ち</span></span></span><span begin="00:32.860" end="00:33.420">さ</span><span begin="00:33.420" end="00:34.057">え</span><span begin="00:34.057" end="00:34.692">い</span><span begin="00:34.692" end="00:35.163">つ</span><span begin="00:35.163" end="00:36.224">か</span><span begin="00:36.224" end="00:36.469" tts:ruby="container"><span tts:ruby="base">消</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:36.224" end="00:36.469">き</span></span></span><span begin="00:36.469" end="00:36.693">え</span><span begin="00:36.693" end="00:38.575">て</span></p><p xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xml:id="line-55badc97-3897-4fa8-ba16-fc22bc156d68" itunes:key="line-55badc97-3897-4fa8-ba16-fc22bc156d68" begin="00:39.455" end="00:44.827" ttm:agent="v1"><span begin="00:39.455" end="00:39.789">そ</span><span begin="00:39.789" end="00:39.978">れ</span><span begin="00:39.978" end="00:40.216">で</span><span begin="00:40.216" end="00:41.380">も</span> <span begin="00:41.475" end="00:41.957" tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:41.475" end="00:41.725">き</span><span tts:ruby="text" begin="00:41.725" end="00:41.957">み</span></span></span><span begin="00:41.957" end="00:43.259">が</span><span begin="00:43.259" end="00:43.479">く</span><span begin="00:43.479" end="00:43.703">れ</span><span begin="00:43.703" end="00:44.827">た</span></p><p xmlns:itunes="http://music.apple.com/lyric-ttml-inter