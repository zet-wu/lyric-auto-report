{
  "song": "s12",
  "name": "白い季節",
  "audio": "datasets/audio/白い季節.m4a",
  "lines": [
    {
      "id": "s12-n523",
      "text": "のぼった坂道に"
    },
    {
      "id": "s12-n539",
      "text": "立ち止まる影ぼうし"
    },
    {
      "id": "s12-n559",
      "text": "どうして今ふたりは"
    },
    {
      "id": "s12-n573",
      "text": "風に吹かれている"
    },
    {
      "id": "s12-n589",
      "text": "途切れた言葉に"
    },
    {
      "id": "s12-n610",
      "text": "泣きそうになるけれど"
    },
    {
      "id": "s12-n624",
      "text": "流れる雲見上げて"
    },
    {
      "id": "s12-n647",
      "text": "だいじょうぶってつぶやいた"
    },
    {
      "id": "s12-n660",
      "text": "白い季節が扉を開けて"
    },
    {
      "id": "s12-n690",
      "text": "切符2枚の旅"
    },
    {
      "id": "s12-n713",
      "text": "他には何も知らなくていい"
    },
    {
      "id": "s12-n737",
      "text": "横顔見つめてたい"
    },
    {
      "id": "s12-n757",
      "text": "教えてふたりの未来"
    },
    {
      "id": "s12-n778",
      "text": "明日を映す鏡が欲しい"
    },
    {
      "id": "s12-n805",
      "text": "ふるえて揺れる気持ち"
    },
    {
      "id": "s12-n825",
      "text": "あふれそう"
    },
    {
      "id": "s12-n831",
      "text": "あなたの色に"
    },
    {
      "id": "s12-n842",
      "text": "ただ染まりたくて"
    },
    {
      "id": "s12-n854",
      "text": "不思議ねいつの間に"
    },
    {
      "id": "s12-n876",
      "text": "こんなにも透き通る"
    },
    {
      "id": "s12-n893",
      "text": "心を通わせてる"
    },
    {
      "id": "s12-n910",
      "text": "運命を信じたい"
    },
    {
      "id": "s12-n930",
      "text": "小鳥のように私待ってる"
    },
    {
      "id": "s12-n957",
      "text": "息をひそめてずっと"
    },
    {
      "id": "s12-n971",
      "text": "甘い木の実がはぜる瞬間"
    },
    {
      "id": "s12-n1001",
      "text": "何かが変わってゆく"
    },
    {
      "id": "s12-n1018",
      "text": "指先 なぞる名前が"
    },
    {
      "id": "s12-n1042",
      "text": "微笑み描く"
    },
    {
      "id": "s12-n1056",
      "text": "優しい時間を"
    },
    {
      "id": "s12-n1070",
      "text": "伝えて 淡い願い消えぬ間に"
    },
    {
      "id": "s12-n1101",
      "text": "あなたの胸で眠る夢を見てる"
    },
    {
      "id": "s12-n1130",
      "text": "白い季節が扉を開けて"
    },
    {
      "id": "s12-n1160",
      "text": "切符2枚の旅"
    },
    {
      "id": "s12-n1183",
      "text": "他には何も知らなくていい"
    },
    {
      "id": "s12-n1207",
      "text": "横顔見つめてたい"
    },
    {
      "id": "s12-n1227",
      "text": "教えてふたりの未来"
    },
    {
      "id": "s12-n1248",
      "text": "明日を映す鏡が欲しい"
    },
    {
      "id": "s12-n1275",
      "text": "ふるえて揺れる気持ち"
    },
    {
      "id": "s12-n1295",
      "text": "あふれそう"
    },
    {
      "id": "s12-n1301",
      "text": "あなたの色に"
    },
