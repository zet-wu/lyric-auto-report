{
  "song": "j05",
  "name": "j05 - The Brave Under The Summer Sky",
  "audio": "datasets/audio/j05 - The Brave Under The Summer Sky.m4a",
  "lines": [
    {
      "id": "j05-n539",
      "text": "いつも何か探してたけれど"
    },
    {
      "id": "j05-n560",
      "text": "みつからないとしってた"
    },
    {
      "id": "j05-n572",
      "text": "ふと視線留めて"
    },
    {
      "id": "j05-n590",
      "text": "およぐ先には"
    },
    {
      "id": "j05-n604",
      "text": "影ひとつ揺らいでた"
    },
    {
      "id": "j05-n621",
      "text": "変わらない窓辺"
    },
    {
      "id": "j05-n639",
      "text": "夏の予感がせつなくて"
    },
    {
      "id": "j05-n661",
      "text": "心のカド欠けていた"
    },
    {
      "id": "j05-n679",
      "text": "怯える声隠す"
    },
    {
      "id": "j05-n698",
      "text": "壊れそうな笑顔"
    },
    {
      "id": "j05-n717",
      "text": "いつかきっと"
    },
    {
      "id": "j05-n724",
      "text": "そうよこの永遠を伝えて"
    },
    {
      "id": "j05-n748",
      "text": "広がるこの世界で"
    },
    {
      "id": "j05-n768",
      "text": "お願い涙忘れて"
    },
    {
      "id": "j05-n789",
      "text": "そう果てなく高い空から"
    },
    {
      "id": "j05-n812",
      "text": "降り注ぐ純粋感じれば"
    },
    {
      "id": "j05-n842",
      "text": "大切な記憶を綴って"
    },
    {
      "id": "j05-n871",
      "text": "夢見てたなんて"
    },
    {
      "id": "j05-n886",
      "text": "言えないから"
    },
    {
      "id": "j05-n896",
      "text": "胸の隙間に隱した"
    },
    {
      "id": "j05-n920",
      "text": "恋することとか"
    },
    {
      "id": "j05-n932",
      "text": "わからないけど"
    },
    {
      "id": "j05-n940",
      "text": "本当は期待してた"
    },
    {
      "id": "j05-n964",
      "text": "指先絡めて"
    },
    {
      "id": "j05-n982",
      "text": "みつめあえれば"
    },
    {
      "id": "j05-n990",
      "text": "いつだって"
    },
    {
      "id": "j05-n996",
      "text": "わかりあうと信じてた"
    },
    {
      "id": "j05-n1011",
      "text": "夕暮れただひとり"
    },
    {
      "id": "j05-n1027",
      "text": "繰り返す今も"
    },
    {
      "id": "j05-n1045",
      "text": "だから決めた"
    },
    {
      "id": "j05-n1055",
      "text": "そうよ"
    },
    {
      "id": "j05-n1059",
      "text": "この高鳴りを届けて"
    },
    {
      "id": "j05-n1080",
      "text": "つかんだその勇気で"
    },
    {
      "id": "j05-n1097",
      "text": "悲しむ闇を壊せば"
    },
    {
      "id": "j05-n1118",
      "text": "そう震える風切り裂いて"
    },
    {
      "id": "j05-n1144",
      "text": "運命なんて変えていくから"
    },
    {
      "id": "j05-n1168",
      "text": "この想いは時を越えて"
    },
    {
      "id": "j05-n1190",
      "text": "遠く星の輝きを"
    },
    {
      "id": "j05-n1211",
      "text": "伸ばした手の向こうに"
    },
    {
      "id": "j05-n1231",
      "text": "見つけて"
    },
    {
      "id": "j05-n1239",
      "text": "あなたと描きたい"
    },
    {
      "id": "j05-n1252",
      "text": "未来を"
    }
  ]
}
