{
  "song": "j02",
  "name": "j02 - POWDER SNOW (Live Ver.)",
  "audio": "datasets/audio/j02 - POWDER SNOW (Live Ver.).m4a",
  "lines": [
    {
      "id": "j02-n479",
      "text": "粉雪が空から"
    },
    {
      "id": "j02-n498",
      "text": "優しく降りてくる"
    },
    {
      "id": "j02-n514",
      "text": "手のひらで受け止めた"
    },
    {
      "id": "j02-n534",
      "text": "雪が切ない"
    },
    {
      "id": "j02-n548",
      "text": "どこかで見てますか"
    },
    {
      "id": "j02-n561",
      "text": "あなたは立ち止まり"
    },
    {
      "id": "j02-n577",
      "text": "思い出していますか"
    },
    {
      "id": "j02-n594",
      "text": "空を見上げながら"
    },
    {
      "id": "j02-n613",
      "text": "嬉しそうに"
    },
    {
      "id": "j02-n623",
      "text": "雪の上を歩くあなたが"
    },
    {
      "id": "j02-n646",
      "text": "In  the  white  snow  fall"
    },
    {
      "id": "j02-n652",
      "text": "私には本当に いとおしく見えた"
    },
    {
      "id": "j02-n683",
      "text": "今でも覚えている"
    },
    {
      "id": "j02-n700",
      "text": "あの日見た雪の白さ"
    },
    {
      "id": "j02-n724",
      "text": "初めて触れた唇の温もりも"
    },
    {
      "id": "j02-n754",
      "text": "忘れない"
    },
    {
      "id": "j02-n763",
      "text": "I still love you"
    },
    {
      "id": "j02-n768",
      "text": "粉雪が私に"
    },
    {
      "id": "j02-n787",
      "text": "いくつも降りかかる"
    },
    {
      "id": "j02-n800",
      "text": "暖かいあなたの"
    },
    {
      "id": "j02-n813",
      "text": "優しさに似ている"
    },
    {
      "id": "j02-n829",
      "text": "楽しそうに"
    },
    {
      "id": "j02-n839",
      "text": "話をしてくれたあなたが"
    },
    {
      "id": "j02-n856",
      "text": "In the white snow fall"
    },
    {
      "id": "j02-n862",
      "text": "私には心から恋しく思えた"
    },
    {
      "id": "j02-n893",
      "text": "今でも夢を見るの"
    },
    {
      "id": "j02-n913",
      "text": "あの日見た白い世界"
    },
    {
      "id": "j02-n940",
      "text": "あの時触れた指先の冷たさも"
    },
    {
      "id": "j02-n973",
      "text": "忘れない"
    },
    {
      "id": "j02-n982",
      "text": "I still love you"
    },
    {
      "id": "j02-n987",
      "text": "今でも覚えている"
    },
    {
      "id": "j02-n1004",
      "text": "あの日見た雪の白さ"
    },
    {
      "id": "j02-n1028",
      "text": "初めて触れた唇の温もりも"
    },
    {
      "id": "j02-n1058",
      "text": "忘れない"
    },
    {
      "id": "j02-n1067",
      "text": "粉雪のようなあなたは"
    },
    {
      "id": "j02-n1086",
      "text": "汚れなく綺麗で"
    },
    {
      "id": "j02-n1105",
      "text": "私もなりたいと"
    },
    {
      "id": "j02-n1118",
      "text": "雪に"
    },
    {
      "id": "j02-n1125",
      "text": "願う"
    },
    {
      "id": "j02-n1132",
      "text": "I still love you"
    }
  ]
}
