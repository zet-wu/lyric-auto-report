{
  "song": "j05",
  "name": "j05 - The Brave Under The Summer Sky",
  "audio": "datasets/audio/j05 - The Brave Under The Summer Sky.m4a",
  "lines": [
    {
      "id": "j05-n540",
      "text": "いつも何か探してたけれど"
    },
    {
      "id": "j05-n561",
      "text": "みつからないとしってた"
    },
    {
      "id": "j05-n573",
      "text": "ふと視線留めて"
    },
    {
      "id": "j05-n591",
      "text": "およぐ先には"
    },
    {
      "id": "j05-n605",
      "text": "影ひとつ揺らいでた"
    },
    {
      "id": "j05-n622",
      "text": "変わらない窓辺"
    },
    {
      "id": "j05-n640",
      "text": "夏の予感がせつなくて"
    },
    {
      "id": "j05-n662",
      "text": "心のカド欠けていた"
    },
    {
      "id": "j05-n680",
      "text": "怯える声隠す"
    },
    {
      "id": "j05-n699",
      "text": "壊れそうな笑顔"
    },
    {
      "id": "j05-n718",
      "text": "いつかきっと"
    },
    {
      "id": "j05-n725",
      "text": "そうよこの永遠を伝えて"
    },
    {
      "id": "j05-n749",
      "text": "広がるこの世界で"
    },
    {
      "id": "j05-n769",
      "text": "お願い涙忘れて"
    },
    {
      "id": "j05-n790",
      "text": "そう果てなく高い空から"
    },
    {
      "id": "j05-n813",
      "text": "降り注ぐ純粋感じれば"
    },
    {
      "id": "j05-n843",
      "text": "大切な記憶を綴って"
    },
    {
      "id": "j05-n872",
      "text": "夢見てたなんて"
    },
    {
      "id": "j05-n887",
      "text": "言えないから"
    },
    {
      "id": "j05-n897",
      "text": "胸の隙間に隱した"
    },
    {
      "id": "j05-n921",
      "text": "恋することとか"
    },
    {
      "id": "j05-n933",
      "text": "わからないけど"
    },
    {
      "id": "j05-n941",
      "text": "本当は期待してた"
    },
    {
      "id": "j05-n965",
      "text": "指先絡めて"
    },
    {
      "id": "j05-n983",
      "text": "みつめあえれば"
    },
    {
      "id": "j05-n991",
      "text": "いつだって"
    },
    {
      "id": "j05-n997",
      "text": "わかりあうと信じてた"
    },
    {
      "id": "j05-n1012",
      "text": "夕暮れただひとり"
    },
    {
      "id": "j05-n1028",
      "text": "繰り返す今も"
    },
    {
      "id": "j05-n1046",
      "text": "だから決めた"
    },
    {
      "id": "j05-n1056",
      "text": "そうよ"
    },
    {
      "id": "j05-n1060",
      "text": "この高鳴りを届けて"
    },
    {
      "id": "j05-n1081",
      "text": "つかんだその勇気で"
    },
    {
      "id": "j05-n1098",
      "text": "悲しいむ闇を壊せば"
    },
    {
      "id": "j05-n1120",
      "text": "そう震える風切り裂いて"
    },
    {
      "id": "j05-n1146",
      "text": "命運なんて変えていくから"
    },
    {
      "id": "j05-n1170",
      "text": "この想いは時を越えて"
    },
    {
      "id": "j05-n1192",
      "text": "遠く星の輝きを"
    },
    {
      "id": "j05-n1213",
      "text": "伸ばした手の向こうに"
    },
    {
      "id": "j05-n1233",
      "text": "見つけて"
    },
    {
      "id": "j05-n1241",
      "text": "あなたと描きたい"
    },
    {
      "id": "j05-n1254",
      "text": "未来を"
    }
  ]
}
