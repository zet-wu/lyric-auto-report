{
  "song": "j18",
  "name": "j18 - 真紅の刃",
  "audio": "datasets/audio/j18 - 真紅の刃.m4a",
  "lines": [
    {
      "id": "j18-n500",
      "text": "屍を越えて行け"
    },
    {
      "id": "j18-n520",
      "text": "焦土と化したこの大地を"
    },
    {
      "id": "j18-n549",
      "text": "灰の雨が黒く塗り"
    },
    {
      "id": "j18-n573",
      "text": "潰していくよ 静寂"
    },
    {
      "id": "j18-n590",
      "text": "それぞれの覚悟を掲げて"
    },
    {
      "id": "j18-n609",
      "text": "戦いを終えた同志よ"
    },
    {
      "id": "j18-n634",
      "text": "又会うその日まで"
    },
    {
      "id": "j18-n653",
      "text": "恐れ戸惑い"
    },
    {
      "id": "j18-n670",
      "text": "幾度重ねて果てのないほど"
    },
    {
      "id": "j18-n697",
      "text": "高く高く聳える壁"
    },
    {
      "id": "j18-n722",
      "text": "剣が呼んでいる"
    },
    {
      "id": "j18-n738",
      "text": "拳の中の忍耐"
    },
    {
      "id": "j18-n758",
      "text": "出会って別れての輪廻の先に"
    },
    {
      "id": "j18-n792",
      "text": "燃え尽きそうな世界が"
    },
    {
      "id": "j18-n816",
      "text": "7日を生きるのなら"
    },
    {
      "id": "j18-n836",
      "text": "僕は8日を生きよう"
    },
    {
      "id": "j18-n860",
      "text": "真紅の刃"
    },
    {
      "id": "j18-n877",
      "text": "刺し違えたとしても"
    },
    {
      "id": "j18-n894",
      "text": "この胸に栄光を咲かせ"
    },
    {
      "id": "j18-n915",
      "text": "あの日を生き抜いた証が"
    },
    {
      "id": "j18-n941",
      "text": "道に成るなら"
    },
    {
      "id": "j18-n955",
      "text": "最後がせめて"
    },
    {
      "id": "j18-n969",
      "text": "君の記憶で"
    },
    {
      "id": "j18-n986",
      "text": "華々しいものであるように"
    },
    {
      "id": "j18-n1007",
      "text": "願いながら"
    },
    {
      "id": "j18-n1017",
      "text": "剣は覚えてる"
    },
    {
      "id": "j18-n1033",
      "text": "消え入りそうな犠牲"
    },
    {
      "id": "j18-n1053",
      "text": "震える足で大地"
    },
    {
      "id": "j18-n1076",
      "text": "踏み締めていざ行け"
    },
    {
      "id": "j18-n1095",
      "text": "誰もが望む未来が"
    },
    {
      "id": "j18-n1119",
      "text": "7日を逃げきるなら"
    },
    {
      "id": "j18-n1139",
      "text": "僕は8日を走ろう"
    },
    {
      "id": "j18-n1163",
      "text": "真紅の刃"
    },
    {
      "id": "j18-n1180",
      "text": "剣が呼んでいる"
    },
    {
      "id": "j18-n1196",
      "text": "拳の中の忍耐"
    },
    {
      "id": "j18-n1216",
      "text": "出会って別れての輪廻の先に"
    },
    {
      "id": "j18-n1250",
      "text": "燃え尽きそうな世界が"
    },
    {
      "id": "j18-n1274",
      "text": "7日を生きるのなら"
    },
    {
      "id": "j18-n1294",
      "text": "僕は8日を生きよう"
    },
