{
  "song": "j20",
  "name": "j20 - 銀腕・アガートラーム",
  "audio": "datasets/audio/j20 - 銀腕・アガートラーム.m4a",
  "lines": [
    {
      "id": "j20-n84",
      "text": "真の強さとは何か？"
    },
    {
      "id": "j20-n106",
      "text": "探し彷徨う"
    },
    {
      "id": "j20-n120",
      "text": "誇ること？契ること？"
    },
    {
      "id": "j20-n139",
      "text": "まだ見えず"
    },
    {
      "id": "j20-n148",
      "text": "想い出の微笑みに"
    },
    {
      "id": "j20-n171",
      "text": "問いかけ続けた"
    },
    {
      "id": "j20-n186",
      "text": "まだ残る手の熱を"
    },
    {
      "id": "j20-n206",
      "text": "忘れはしない"
    },
    {
      "id": "j20-n217",
      "text": "惑い 迷い 苦しむことで"
    },
    {
      "id": "j20-n240",
      "text": "罪を抉り 隠し逃げずに"
    },
    {
      "id": "j20-n266",
      "text": "あるがままの自分の声で"
    },
    {
      "id": "j20-n289",
      "text": "勇気を問え 決意を撃て"
    },
    {
      "id": "j20-n320",
      "text": "それがわたしの聖剣 翳せ！"
    },
    {
      "id": "j20-n345",
      "text": "弱くてもいい"
    },
    {
      "id": "j20-n356",
      "text": "涙を流してもいいさ"
    },
    {
      "id": "j20-n375",
      "text": "絶対負けない歌"
    },
    {
      "id": "j20-n398",
      "text": "それが心にあるのなら"
    },
    {
      "id": "j20-n414",
      "text": "運命も 過去も"
    },
    {
      "id": "j20-n431",
      "text": "嘆きも 記憶も 愛も"
    },
    {
      "id": "j20-n455",
      "text": "ぐっと握って"
    },
    {
      "id": "j20-n466",
      "text": "今 足掻き踠きそして立つ"
    },
    {
      "id": "j20-n495",
      "text": "わたしらしさを見つけた"
    },
    {
      "id": "j20-n510",
      "text": "胸に今日を刻んで"
    },
    {
      "id": "j20-n530",
      "text": "十字なるこの輝き"
    },
    {
      "id": "j20-n551",
      "text": "その意味とは？"
    },
    {
      "id": "j20-n565",
      "text": "名に宿る忘却 わたしの正義"
    },
    {
      "id": "j20-n597",
      "text": "銀色の左腕に慈愛を込めて"
    },
    {
      "id": "j20-n633",
      "text": "闇を裂け 悪を断て"
    },
    {
      "id": "j20-n656",
      "text": "無双を放て"
    },
    {
      "id": "j20-n673",
      "text": "世界分の1を独奏き"
    },
    {
      "id": "j20-n702",
      "text": "脆い自分全て晒して"
    },
    {
      "id": "j20-n731",
      "text": "例え膝をつく日が来ても"
    },
    {
      "id": "j20-n757",
      "text": "ハートだけは 夢だけは"
    },
    {
      "id": "j20-n772",
      "text": "決して土で汚さない…決して！"
    },
    {
      "id": "j20-n803",
      "text": "弱くてもいい"
    },
    {
      "id": "j20-n814",
      "text": "平凡な拳でもいい"
    },
    {
      "id": "j20-n836",
      "text": "絶対突き出すこと"
    },
    {
      "id": "j20-n859",
      "text": "この手覚えているのなら"
    },
    {
      "id": "j20-n878",
      "text": "悔しささえも"
    },
    {
      "id": "j20-n889",
      "text": "恥ずかしめでも何でも"
    },
    {
      "id": "j20-n907",
      "text": "ぐっと握って"
    },
    {
      "id": "j20-n918",
      "text": "今 この身は炎となる"
    },
    {
      "id": "j20-n940",
      "text": "泥に塗れた奇跡も"
    },
    {
      "id": "j20-n964",
      "text": "天は見てくれている"
    },
    {
      "id": "j20-n981",
      "text": "勇気を問え 決意を撃て"
    },
    {
      "id": "j20-n1012",
      "text": "それがわたしの聖剣 翳せ！"
    },
    {
      "id": "j20-n1037",
      "text": "弱くてもいい"
    },
    {
      "id": "j20-n1048",
      "text": "涙を流してもいいさ"
    },
    {
      "id": "j20-n1067",
      "text": "絶対負けない歌"
    },
    {
      "id": "j20-n1090",
      "text": "それが心にあるのなら"
    },
    {
      "id": "j20-n1106",
      "text": "雫の通る道にはきっと綺麗な"
    },
    {
      "id": "j20-n1140",
      "text": "自分色の未来"
    },
    {
      "id": "j20-n1165",
      "text": "煌めいているはずだ…！"
    },
    {
      "id": "j20-n1180",
      "text": "弱くてもいい"
    },
    {
      "id": "j20-n1191",
      "text": "平凡な拳でもいい"
    },
    {
      "id": "j20-n1213",
      "text": "絶対突き出すこと"
    },
    {
      "id": "j20-n1236",
      "text": "この手覚えているのなら"
    },
    {
      "id": "j20-n1255",
      "text": "慟哭 、嗚咽 、憎しみ、苦痛も全部"
    },
    {
      "id": "j20-n1304",
      "text": "ぐっと握って"
    },
    {
      "id": "j20-n1315",
      "text": "今 足掻きもがきそして立つ"
    },
    {
      "id": "j20-n1341",
      "text": "わたしらしさを見つけた"
    },
    {
      "id": "j20-n1356",
      "text": "胸に今日を刻んで"
    },
    {
      "id": "j20-n1376",
      "text": "此処に†の歌を"
    }
  ]
}
