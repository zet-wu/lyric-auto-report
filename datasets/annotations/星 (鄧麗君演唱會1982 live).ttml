<tt xmlns="http://www.w3.org/ns/ttml" xmlns:amll="http://www.example.com/ns/amll" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:space="preserve"><head><metadata><amll:meta key="musicName" value="星 (Live)"/><amll:meta key="artists" value="鄧麗君"/><amll:meta key="album" value="但願人長久：鄧麗君15週年紀念集"/><amll:meta key="lyricist" value="谷村新司"/><amll:meta key="lyricist" value="鄭國江"/><amll:meta key="composer" value="谷村新司"/><ttm:agent xml:id="v1" type="person"><ttm:name>日语</ttm:name></ttm:agent><ttm:agent xml:id="v2" type="person"><ttm:name>粤语</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation type="subtitle"><text for="line-93364e6a-2e06-4cb5-b4c0-cca4987c1400">闭上双眼何物都无法看见</text><text for="line-cc14df4e-02b8-4ce5-96e3-edb741c39caf">悲伤着张开双眼的话</text><text for="line-46f25f03-35b2-4c25-b664-2dd0c31f7d9d">除了通向荒野的道路</text><text for="line-08c35f27-abf2-4721-8d9d-e2f0c394c8f4">再无其他可见之物</text><text for="line-2a3cfe14-2cde-4ade-904c-98084972fdec">啊 破碎散落的</text><text for="line-5e239057-0cea-4bad-8330-9a2f1478e014">至少鲜明地</text><text for="line-2f4a3872-d85c-4449-8ca2-ff03bf774bf7">我就要前行 带着泛着苍白的面颊</text><text for="line-63b724fd-4a67-480c-a1e7-5405ea7e735d">我将要前行 别了 昴星啊</text><text for="2f7d87fb-0365-4b08-8122-9ef8691fdb3e">宿命的群星啊</text><text for="be5deae4-ede1-4d33-94ed-9b89b3f15e01">照耀我这身躯吧</text></translation></translations></iTunesMetadata></metadata></head><body dur="04:30.610"><div><p xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xml:id="line-93364e6a-2e06-4cb5-b4c0-cca4987c1400" itunes:key="line-93364e6a-2e06-4cb5-b4c0-cca4987c1400" begin="00:26.122" end="00:31.183" ttm:agent="v1"><span begin="00:26.122" end="00:26.594" tts:ruby="container"><span tts:ruby="base">目</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:26.122" end="00:26.594">め</span></span></span><span begin="00:26.594" end="00:26.966">を</span><span begin="00:26.966" end="00:27.219"