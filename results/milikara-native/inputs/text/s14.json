{
  "song": "s14",
  "name": "骹车破尼",
  "audio": "datasets/audio/骹车破尼.m4a",
  "lines": [
    {
      "id": "s14-n54",
      "text": "落雨答滴骹车破尼"
    },
    {
      "id": "s14-n66",
      "text": "牵去修理身顶无钱"
    },
    {
      "id": "s14-n75",
      "text": "爱拍手机佮人借钱"
    },
    {
      "id": "s14-n87",
      "text": "怎知欠费停机"
    },
    {
      "id": "s14-n94",
      "text": "想起昨日我许粒女"
    },
    {
      "id": "s14-n106",
      "text": "骗我感情诈我个钱"
    },
    {
      "id": "s14-n115",
      "text": "呾伊啊父"
    },
    {
      "id": "s14-n120",
      "text": "流血答滴"
    },
    {
      "id": "s14-n125",
      "text": "企在中心医院"
    },
    {
      "id": "s14-n132",
      "text": "积恶死 我真实相信伊"
    },
    {
      "id": "s14-n142",
      "text": "现金硬币存折"
    },
    {
      "id": "s14-n149",
      "text": "通身家产全部分伊"
    },
    {
      "id": "s14-n158",
      "text": "伊挈了走去覕"
    },
    {
      "id": "s14-n165",
      "text": "积恶死 我真是积恶死"
    },
    {
      "id": "s14-n175",
      "text": "通身揣无毫子"
    },
    {
      "id": "s14-n185",
      "text": "了还睹着骹车破尼"
    },
    {
      "id": "s14-n197",
      "text": "我决定从此唔钓女"
    },
    {
