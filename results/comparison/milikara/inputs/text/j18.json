{
  "song": "j18",
  "name": "j18 - 真紅の刃",
  "audio": "datasets/audio/j18 - 真紅の刃.m4a",
  "lines": [
    {
      "id": "j18-n500",
      "text": "屍を越えて行け"
    },
    {
      "id": "j18-n520",
      "text": "焦土と化したこの大地を"
    },
    {
      "id": "j18-n549",
      "text": "灰の雨が黒く塗り"
    },
    {
      "id": "j18-n573",
      "text": "潰していくよ 静寂"
    },
    {
      "id": "j18-n589",
      "text": "それぞれの覚悟を掲げて"
    },
    {
      "id": "j18-n608",
      "text": "戦いを終えた同志よ"
    },
    {
      "id": "j18-n633",
      "text": "又会うその日まで"
    },
    {
      "id": "j18-n652",
      "text": "恐れ戸惑い"
    },
    {
      "id": "j18-n669",
      "text": "幾度重ねて果てのないほど"
    },
    {
      "id": "j18-n696",
      "text": "高く高く聳える壁"
    },
    {
      "id": "j18-n721",
      "text": "剣が呼んでいる"
    },
    {
      "id": "j18-n737",
      "text": "拳の中の忍耐"
    },
    {
      "id": "j18-n757",
      "text": "出会って別れての輪廻の先に"
    },
    {
      "id": "j18-n791",
      "text": "燃え尽きそうな世界が"
    },
    {
      "id": "j18-n815",
      "text": "7日を生きるのなら"
    },
    {
      "id": "j18-n835",
      "text": "僕は8日を生きよう"
    },
    {
      "id": "j18-n858",
      "text": "真紅の刃"
    },
    {
      "id": "j18-n875",
      "text": "刺し違えたとしても"
    },
    {
      "id": "j18-n892",
      "text": "この胸に栄光を咲かせ"
    },
    {
      "id": "j18-n913",
      "text": "あの日を生き抜いた証が"
    },
    {
      "id": "j18-n939",
      "text": "道に成るなら"
    },
    {
      "id": "j18-n953",
      "text": "最後がせめて"
    },
    {
      "id": "j18-n967",
      "text": "君の記憶で"
    },
    {
      "id": "j18-n984",
      "text": "華々しいものであるように"
    },
    {
      "id": "j18-n1005",
      "text": "願いながら"
    },
    {
      "id": "j18-n1015",
      "text": "剣は覚えてる"
    },
    {
      "id": "j18-n1031",
      "text": "消え入りそうな犠牲"
    },
    {
      "id": "j18-n1051",
      "text": "震える足で大地"
    },
    {
      "id": "j18-n1074",
      "text": "踏み締めていざ行け"
    },
    {
      "id": "j18-n1093",
      "text": "誰もが望む未来が"
    },
    {
      "id": "j18-n1117",
      "text": "7日を逃げきるなら"
    },
    {
      "id": "j18-n1137",
      "text": "僕は8日を走ろう"
    },
    {
      "id": "j18-n1160",
      "text": "真紅の刃"
    },
    {
      "id": "j18-n1177",
      "text": "剣が呼んでいる"
    },
    {
      "id": "j18-n1193",
      "text": "拳の中の忍耐"
    },
    {
      "id": "j18-n1213",
      "text": "出会って別れての輪廻の先に"
    },
    {
      "id": "j18-n1247",
      "text": "燃え尽きそうな世界が"
    },
    {
      "id": "j18-n1271",
      "text": "7日を生きるのなら"
    },
    {
      "id": "j18-n1291",
