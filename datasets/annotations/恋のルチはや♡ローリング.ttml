span tts:ruby="text" begin="00:34.651" end="00:34.991">りょ</span><span tts:ruby="text" begin="00:34.991" end="00:35.274">う</span></span></span><span begin="00:35.274" end="00:35.611" tts:ruby="container"><span tts:ruby="base">者</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:35.274" end="00:35.611">しゃ</span></span></span></p><p xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xml:id="line-ed2955d4-6172-4250-9bdd-5483db23c755" itunes:key="line-ed2955d4-6172-4250-9bdd-5483db23c755" begin="00:35.718" end="00:38.531" ttm:agent="v2"><span begin="00:35.718" end="00:35.891" tts:ruby="container"><span tts:ruby="base">目</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:35.718" end="00:35.891">め</span></span></span><span begin="00:35.891" end="00:36.071" tts:ruby="container"><span tts:ruby="base">覚</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:35.891" end="00:36.071">ざ</span></span></span><span begin="00:36.071" end="00:36.231">め</span><span begin="00:36.231" end="00:36.731">の</span> <span begin="00:36.731" end="00:37.131" tts:ruby="container"><span tts:ruby="base">合</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:36.731" end="00:36.951">あ</span><span tts:ruby="text" begin="00:36.951" end="00:37.131">い</span></span></span><span begin="00:37.131" end="00:37.311" tts:ruby="container"><span tts:ruby="base">図</span><span tts:ruby="textContainer"><span tts:ruby="text" begin="00:37.131" end="00:37.311">ず</span></span></span><span begin="00:37.311" end="00:37.500">は</span> <span begin="00:37.500" end="00:37.871">そ</span><span begin="00:37.871" end="00:38.211">っ</span><span begin="00:38.211" end="00:38.531">と</span></p><p xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xml:id="line-3a800ab7-f312-45aa-968c-4355eb17de2e" itunes:key="line-3a800ab7-f312-45aa-968c-4355eb17de2e" begin="00:38.584" end="00:41.411" ttm:agent="v2"><span begin="00:38.584" end="00:38.931" tts:ruby="container"><s