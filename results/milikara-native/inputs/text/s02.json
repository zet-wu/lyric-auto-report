{
  "song": "s02",
  "name": "POWDER SNOW (Live Ver.)",
  "audio": "datasets/audio/POWDER SNOW (Live Ver.).m4a",
  "lines": [
    {
      "id": "s02-n400",
      "text": "粉雪が空から"
    },
    {
      "id": "s02-n420",
      "text": "優しく降りてくる"
    },
    {
      "id": "s02-n437",
      "text": "手のひらで受け止めた"
    },
    {
      "id": "s02-n458",
      "text": "雪が切ない"
    },
    {
      "id": "s02-n473",
      "text": "どこかで見てますか"
    },
    {
      "id": "s02-n487",
      "text": "あなたは立ち止まり"
    },
    {
      "id": "s02-n504",
      "text": "思い出していますか"
    },
    {
      "id": "s02-n522",
      "text": "空を見上げながら"
    },
    {
      "id": "s02-n542",
      "text": "嬉しそうに"
    },
    {
      "id": "s02-n553",
      "text": "雪の上を歩くあなたが"
    },
    {
      "id": "s02-n577",
      "text": "In  the  white  snow  fall"
    },
    {
      "id": "s02-n584",
      "text": "私には本当に いとおしく見えた"
    },
    {
      "id": "s02-n616",
      "text": "今でも覚えている"
    },
    {
      "id": "s02-n634",
      "text": "あの日見た雪の白さ"
    },
    {
      "id": "s02-n659",
      "text": "初めて触れた唇の温もりも"
    },
    {
      "id": "s02-n690",
      "text": "忘れない"
    },
    {
      "id": "s02-n700",
      "text": "I still love you"
    },
    {
      "id": "s02-n706",
      "text": "粉雪が私に"
    },
    {
      "id": "s02-n726",
      "text": "いくつも降りかかる"
    },
    {
      "id": "s02-n740",
      "text": "暖かいあなたの"
    },
    {
      "id": "s02-n754",
      "text": "優しさに似ている"
    },
    {
      "id": "s02-n771",
      "text": "楽しそうに"
    },
    {
      "id": "s02-n782",
      "text": "話をしてくれたあなたが"
    },
    {
      "id": "s02-n800",
      "text": "In the white snow fall"
    },
    {
      "id": "s02-n807",
      "text": "私には心から恋しく思えた"
    },
    {
      "id": "s02-n839",
      "text": "今でも夢を見るの"
    },
    {
      "id": "s02-n860",
      "text": "あの日見た白い世界"
    },
    {
      "id": "s02-n888",
      "text": "あの時触れた指先の冷たさも"
    },
    {
      "id": "s02-n922",
      "text": "忘れない"
    },
    {
      "id": "s02-n932",
      "text": "I still love you"
    },
    {
      "id": "s02-n938",
      "text": "今でも覚えている"
    },
    {
      "id": "s02-n956",
      "text": "あの日見た雪の白さ"
    },
    {
      "id": "s02-n981",
      "text": "初めて触れた唇の温もりも"
    },
    {
      "id": "s02-n1012",
      "text": "忘れない"
    },
    {
      "id": "s02-n1022",
      "text": "粉雪のようなあなたは"
    },
    {
      "id": "s02-n1042",
      "text": "汚れなく綺麗で"
    },
    {
      "id": "s02-n1062",
      "text": "私もなりたいと"
    },
    {
      "id": "s02-n1076",
      "text": "雪に"
    },
    {
      "id": "s02-n1084",
      "text": "願う"
    },
    {
      "id": "s02-n1091",
      "text": "I still love you"
    }
  ]
}
