  "song": "t01",
  "name": "t01 - 骹车破尼",
  "audio": "datasets/audio/t01 - 骹车破尼.m4a",
  "lines": [
    {
      "id": "t01-n54",
      "text": "落雨答滴骹车破尼"
    },
    {
      "id": "t01-n87",
      "text": "牵去修理身顶无钱"
    },
    {
      "id": "t01-n120",
      "text": "爱拍手机佮人借钱"
    },
    {
      "id": "t01-n153",
      "text": "怎知欠费停机"
    },
    {
      "id": "t01-n178",
      "text": "想起昨日我许粒女"
    },
    {
      "id": "t01-n211",
      "text": "骗我感情诈我个钱"
    },
    {
      "id": "t01-n244",
      "text": "呾伊啊父"
    },
    {
      "id": "t01-n261",
      "text": "流血答滴"
    },
    {
      "id": "t01-n278",
      "text": "企在中心医院"
    },
    {
      "id": "t01-n303",
      "text": "积恶死 我真实相信伊"
    },
    {
      "id": "t01-n340",
      "text": "现金硬币存折"
    },
    {
      "id": "t01-n365",
      "text": "通身家产全部分伊"
    },
    {
      "id": "t01-n398",
      "text": "伊挈了走去覕"
    },
    {
      "id": "t01-n423",
      "text": "积恶死 我真是积恶死"
    },
    {
      "id": "t01-n460",
      "text": "通身揣无毫子"
    },
    {
      "id": "t01-n485",
      "text": "了还睹着骹车破尼"
    },
    {
      "id": "t01-n518",
      "text": "我决定从此唔钓女"
    },
