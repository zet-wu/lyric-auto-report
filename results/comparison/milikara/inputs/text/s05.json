{
  "song": "s05",
  "name": "The Brave Under The Summer Sky",
  "audio": "datasets/audio/The Brave Under The Summer Sky.m4a",
  "lines": [
    {
      "id": "s05-n455",
      "text": "いつも何か探してたけれど"
    },
    {
      "id": "s05-n477",
      "text": "みつからないとしってた"
    },
    {
      "id": "s05-n490",
      "text": "ふと視線留めて"
    },
    {
      "id": "s05-n509",
      "text": "およぐ先には"
    },
    {
      "id": "s05-n524",
      "text": "影ひとつ揺らいでた"
    },
    {
      "id": "s05-n542",
      "text": "変わらない窓辺"
    },
    {
      "id": "s05-n561",
      "text": "夏の予感がせつなくて"
    },
    {
      "id": "s05-n584",
      "text": "心のカド欠けていた"
    },
    {
      "id": "s05-n603",
      "text": "怯える声隠す"
    },
    {
      "id": "s05-n623",
      "text": "壊れそうな笑顔"
    },
    {
      "id": "s05-n643",
      "text": "いつかきっと"
    },
    {
      "id": "s05-n651",
      "text": "そうよこの永遠を伝えて"
    },
    {
      "id": "s05-n676",
      "text": "広がるこの世界で"
    },
    {
      "id": "s05-n697",
      "text": "お願い涙忘れて"
    },
    {
      "id": "s05-n719",
      "text": "そう果てなく高い空から"
    },
    {
      "id": "s05-n743",
      "text": "降り注ぐ純粋感じれば"
    },
    {
      "id": "s05-n774",
      "text": "大切な記憶を綴って"
    },
    {
      "id": "s05-n804",
      "text": "夢見てたなんて"
    },
    {
      "id": "s05-n820",
      "text": "言えないから"
    },
    {
      "id": "s05-n831",
      "text": "胸の隙間に隱した"
    },
    {
      "id": "s05-n856",
      "text": "恋することとか"
    },
    {
      "id": "s05-n869",
      "text": "わからないけど"
    },
    {
      "id": "s05-n878",
      "text": "本当は期待してた"
    },
    {
      "id": "s05-n903",
      "text": "指先絡めて"
    },
    {
      "id": "s05-n922",
      "text": "みつめあえれば"
    },
    {
      "id": "s05-n931",
      "text": "いつだって"
    },
    {
      "id": "s05-n938",
      "text": "わかりあうと信じてた"
    },
    {
      "id": "s05-n954",
      "text": "夕暮れただひとり"
    },
    {
      "id": "s05-n971",
      "text": "繰り返す今も"
    },
    {
      "id": "s05-n990",
      "text": "だから決めた"
    },
    {
      "id": "s05-n1001",
      "text": "そうよ"
    },
    {
      "id": "s05-n1006",
      "text": "この高鳴りを届けて"
    },
    {
      "id": "s05-n1028",
      "text": "つかんだその勇気で"
    },
    {
      "id": "s05-n1046",
      "text": "悲しいむ闇を壊せば"
    },
    {
      "id": "s05-n1069",
      "text": "そう震える風切り裂いて"
    },
    {
      "id": "s05-n1096",
      "text": "命運なんて変えていくから"
    },
    {
      "id": "s05-n1121",
      "text": "この想いは時を越えて"
    },
    {
      "id": "s05-n1144",
      "text": "遠く星の輝きを"
    },
    {
      "id": "s05-n1166",
      "text": "伸ばした手の向こうに"
    },
    {
      "id": "s05-n1187",
      "text": "見つけて"
    },
    {
      "id": "s05-n1196",
      "text": "あなたと描きたい"
    },
    {
      "id": "s05-n1210",
      "text": "未来を"
    }
  ]
}
