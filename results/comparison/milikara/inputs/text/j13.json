{
  "song": "j13",
  "name": "j13 - silver ring",
  "audio": "datasets/audio/j13 - silver ring.m4a",
  "lines": [
    {
      "id": "j13-n354",
      "text": "いつまでも待ってるよと"
    },
    {
      "id": "j13-n369",
      "text": "伝えた日から時を重ね"
    },
    {
      "id": "j13-n395",
      "text": "心に残ってた不安が"
    },
    {
      "id": "j13-n421",
      "text": "水にとけるように消えていく"
    },
    {
      "id": "j13-n442",
      "text": "銀色の光が"
    },
    {
      "id": "j13-n461",
      "text": "薬指に輝いている"
    },
    {
      "id": "j13-n484",
      "text": "信じてた気持ちが"
    },
    {
      "id": "j13-n503",
      "text": "今 結ばれるの"
    },
    {
      "id": "j13-n518",
      "text": "ささやかな幸せを"
    },
    {
      "id": "j13-n532",
      "text": "あなたと守りたい"
    },
    {
      "id": "j13-n545",
      "text": "未来を二人で"
    },
    {
      "id": "j13-n563",
      "text": "歩いていくの"
    },
    {
      "id": "j13-n574",
      "text": "一緒にいようね"
    },
    {
      "id": "j13-n589",
      "text": "透明な泉があふれて"
    },
    {
      "id": "j13-n612",
      "text": "零れそうになったなら"
    },
    {
      "id": "j13-n627",
      "text": "この手でそっとうけとめるの"
    },
    {
      "id": "j13-n644",
      "text": "きっと笑顔になれるでしょう"
    },
    {
      "id": "j13-n664",
      "text": "まっすぐな瞳で"
    },
    {
      "id": "j13-n677",
      "text": "私だけを見つめていてね"
    },
    {
      "id": "j13-n697",
      "text": "優しさを抱きしめ"
    },
    {
      "id": "j13-n713",
      "text": "今 誓い合うの"
    },
    {
      "id": "j13-n731",
      "text": "もう言葉はいらない"
    },
    {
      "id": "j13-n748",
      "text": "微かに聞こえる"
    },
    {
      "id": "j13-n763",
      "text": "あなたの鼓動が"
    },
    {
      "id": "j13-n778",
      "text": "時間を刻む"
    },
    {
      "id": "j13-n795",
      "text": "ずっと…大好きよ"
    },
    {
      "id": "j13-n810",
      "text": "ささやかな幸せを"
    },
    {
      "id": "j13-n824",
      "text": "あなたと守りたい"
    },
    {
      "id": "j13-n837",
      "text": "未来を二人で"
    },
    {
      "id": "j13-n855",
      "text": "歩いていくの"
    },
    {
      "id": "j13-n866",
      "text": "一緒にいようね"
    }
  ]
}
