{
  "song": "jy01",
  "name": "jy01 - 星 (鄧麗君演唱會1982 live)",
  "audio": "datasets/audio/jy01 - 星 (鄧麗君演唱會1982 live).m4a",
  "lines": [
    {
      "id": "jy01-n28",
      "text": "目を閉じて何も見えず"
    },
    {
      "id": "jy01-n52",
      "text": "哀しくて目を開ければ"
    },
    {
      "id": "jy01-n73",
      "text": "荒野に向かう道より"
    },
    {
      "id": "jy01-n97",
      "text": "他に見えるものはなし"
    },
    {
      "id": "jy01-n115",
      "text": "ああ 砕け散る"
    },
    {
      "id": "jy01-n129",
      "text": "宿命の星たちよ"
    },
    {
      "id": "jy01-n145",
      "text": "せめて鮮やかに"
    },
    {
      "id": "jy01-n157",
      "text": "この身を照せよ"
    },
    {
      "id": "jy01-n172",
      "text": "我は行く 蒼白き頬のままで"
    },
    {
      "id": "jy01-n204",
      "text": "我は行く さらば昴よ"
    },
    {
      "id": "jy01-n226",
      "text": "踏过荆棘 苦中找到安静"
    },
    {
      "id": "jy01-n267",
      "text": "踏过荒郊 我双脚是泥泞"
    },
    {
      "id": "jy01-n308",
      "text": "满天星光 我不怕风正劲"
    },
    {
      "id": "jy01-n349",
      "text": "满心是期望 过黑暗是黎明"
    },
    {
      "id": "jy01-n394",
      "text": "啊 星也灿烂 伴我夜行给我影"
    },
    {
      "id": "jy01-n443",
      "text": "啊 星光引路 风之语轻轻听"
    },
    {
      "id": "jy01-n488",
      "text": "带着热情 我要找理想 理想是和平"
    },
    {
      "id": "jy01-n545",
      "text": "寻梦而去 哪怕走崎岖险径"
    },
    {
      "id": "jy01-n590",
      "text": "啊 星也灿烂 伴我夜行给我影"
    },
    {
      "id": "jy01-n639",
      "text": "啊 星光引路 风之语轻轻听"
    },
    {
      "id": "jy01-n684",
      "text": "带着热情 我要找理想 理想是和平"
    },
    {
      "id": "jy01-n741",
      "text": "寻梦而去 哪怕走崎岖险径"
    },
    {
      "id": "jy01-n786",
      "text": "明日谁步过 这星也带领"
    }
  ]
}
