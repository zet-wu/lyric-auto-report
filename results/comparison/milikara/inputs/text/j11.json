{
  "song": "j11",
  "name": "j11 - 白い季節",
  "audio": "datasets/audio/j11 - 白い季節.m4a",
  "lines": [
    {
      "id": "j11-n523",
      "text": "のぼった坂道に"
    },
    {
      "id": "j11-n539",
      "text": "立ち止まる影ぼうし"
    },
    {
      "id": "j11-n559",
      "text": "どうして今ふたりは"
    },
    {
      "id": "j11-n573",
      "text": "風に吹かれている"
    },
    {
      "id": "j11-n589",
      "text": "途切れた言葉に"
    },
    {
      "id": "j11-n610",
      "text": "泣きそうになるけれど"
    },
    {
      "id": "j11-n624",
      "text": "流れる雲見上げて"
    },
    {
      "id": "j11-n647",
      "text": "だいじょうぶってつぶやいた"
    },
    {
      "id": "j11-n660",
      "text": "白い季節が扉を開けて"
    },
    {
      "id": "j11-n690",
      "text": "切符2枚の旅"
    },
    {
      "id": "j11-n713",
      "text": "他には何も知らなくていい"
    },
    {
      "id": "j11-n737",
      "text": "横顔見つめてたい"
    },
    {
      "id": "j11-n757",
      "text": "教えてふたりの未来"
    },
    {
      "id": "j11-n778",
      "text": "明日を映す鏡が欲しい"
    },
    {
      "id": "j11-n805",
      "text": "ふるえて揺れる気持ち"
    },
    {
      "id": "j11-n825",
      "text": "あふれそう"
    },
    {
      "id": "j11-n831",
      "text": "あなたの色に"
    },
    {
      "id": "j11-n842",
      "text": "ただ染まりたくて"
    },
    {
      "id": "j11-n854",
      "text": "不思議ねいつの間に"
    },
    {
      "id": "j11-n876",
      "text": "こんなにも透き通る"
    },
    {
      "id": "j11-n893",
      "text": "心を通わせてる"
    },
    {
      "id": "j11-n910",
      "text": "運命を信じたい"
    },
    {
      "id": "j11-n930",
      "text": "小鳥のように私待ってる"
    },
    {
      "id": "j11-n957",
      "text": "息をひそめてずっと"
    },
    {
      "id": "j11-n971",
      "text": "甘い木の実がはぜる瞬間"
    },
    {
      "id": "j11-n1001",
      "text": "何かが変わってゆく"
    },
    {
      "id": "j11-n1018",
      "text": "指先 なぞる名前が"
    },
    {
      "id": "j11-n1042",
      "text": "微笑み描く"
    },
    {
      "id": "j11-n1059",
      "text": "優しい時間を"
    },
    {
      "id": "j11-n1073",
      "text": "伝えて 淡い願い消えぬ間に"
    },
    {
      "id": "j11-n1104",
      "text": "あなたの胸で眠る夢を見てる"
    },
    {
      "id": "j11-n1133",
      "text": "白い季節が扉を開けて"
    },
    {
      "id": "j11-n1163",
      "text": "切符2枚の旅"
    },
    {
      "id": "j11-n1186",
      "text": "他には何も知らなくていい"
    },
    {
      "id": "j11-n1210",
      "text": "横顔見つめてたい"
    },
    {
      "id": "j11-n1230",
      "text": "教えてふたりの未来"
    },
    {
      "id": "j11-n1251",
      "text": "明日を映す鏡が欲しい"
    },
    {
      "id": "j11-n1278",
      "text": "ふるえて揺れる気持ち"
    },
    {
      "id": "j11-n1298",
