{
  "song": "s03",
  "name": "Rainbow Flower",
  "audio": "datasets/audio/Rainbow Flower.m4a",
  "lines": [
    {
      "id": "s03-n651",
      "text": "Ye-e-Ye-eHa-aKortgungnirmessabaggy"
    },
    {
      "id": "s03-n667",
      "text": "Ye-e-Ye-eHa-aKortgungnirmessabrossy...Gungnir"
    },
    {
      "id": "s03-n685",
      "text": "幾億の歴史を超えて"
    },
    {
      "id": "s03-n713",
      "text": "この胸の問いかけに"
    },
    {
      "id": "s03-n733",
      "text": "応えよShine"
    },
    {
      "id": "s03-n742",
      "text": "焔より熱い想いよ"
    },
    {
      "id": "s03-n764",
      "text": "鋼鉄のイカヅチで"
    },
    {
      "id": "s03-n784",
      "text": "ぶっ飛ばせMy Gungnir"
    },
    {
      "id": "s03-n796",
      "text": "最速で最短で一直線に"
    },
    {
      "id": "s03-n835",
      "text": "光った朝日を"
    },
    {
      "id": "s03-n856",
      "text": "君と共に見たい"
    },
    {
      "id": "s03-n882",
      "text": "今見上げよう"
    },
    {
      "id": "s03-n905",
      "text": "響け伝え歌え"
    },
    {
      "id": "s03-n943",
      "text": "全力で「一人じゃない」と届けたい"
    },
    {
      "id": "s03-n978",
      "text": "響け伝え歌え"
    },
    {
      "id": "s03-n1016",
      "text": "そしてッ！笑おう…!"
    },
    {
      "id": "s03-n1028",
      "text": "この世界には歌がある"
    },
    {
      "id": "s03-n1050",
      "text": "何度でも立ち上がれるさ"
    },
    {
      "id": "s03-n1075",
      "text": "ちょっとだけ来た道を"
    },
    {
      "id": "s03-n1095",
      "text": "見てごらん？"
    },
    {
      "id": "s03-n1104",
      "text": "こんなにも輝いている"
    },
    {
      "id": "s03-n1120",
      "text": "積み上げた物語"
    },
    {
      "id": "s03-n1146",
      "text": "嘘は何もない"
    },
    {
      "id": "s03-n1161",
      "text": "「いつか未来に人は繋がれる」"
    },
    {
      "id": "s03-n1191",
      "text": "大事な友から"
    },
    {
      "id": "s03-n1212",
      "text": "貰った言葉絶対"
    },
    {
      "id": "s03-n1250",
      "text": "夢紡ぐから"
    },
    {
      "id": "s03-n1270",
      "text": "響け伝え歌え"
    },
    {
      "id": "s03-n1308",
      "text": "全開で愛の挽歌よ轟いて"
    },
    {
      "id": "s03-n1344",
      "text": "響け伝え歌え"
    },
    {
      "id": "s03-n1382",
      "text": "そしてッ勇気も"
    },
    {
      "id": "s03-n1397",
      "text": "何もかもを全部束ねよう"
    },
    {
      "id": "s03-n1424",
      "text": "Balwisyallnescellgungnirtron"
    },
    {
      "id": "s03-n1433",
      "text": "Balwisyallnescellgungnirtron"
    },
    {
      "id": "s03-n1442",
      "text": "君と、私 、みんな 、みんな、"
    },
    {
      "id": "s03-n1465",
      "text": "歩みきった、足跡に、"
    },
    {
      "id": "s03-n1488",
      "text": "どんな花が咲くのかなぁ？"
    },
    {
      "id": "s03-n1508",
      "text": "泣いて 、笑い 、生まれ落ちた、"
    },
    {
      "id": "s03-n1536",
      "text": "涙、なみだ…、"
    },
    {
      "id": "s03-n1548",
      "text": "きっと綺麗な虹の花になって"
    },
    {
      "id": "s03-n1577",
      "text": "咲き歌う…！"
    },
    {
      "id": "s03-n1589",
      "text": "響け伝え歌え"
    },
    {
      "id": "s03-n1627",
      "text": "全力で「一人じゃない」と届けたい"
    },
    {
      "id": "s03-n1662",
      "text": "響け伝え歌え"
    },
    {
      "id": "s03-n1700",
      "text": "そしてッ！また会うその日まで"
    },
    {
      "id": "s03-n1720",
      "text": "笑顔の「サヨナラ」だ！"
    },
    {
      "id": "s03-n1750",
      "text": "絶対に…絶対に…ッ！"
    }
  ]
}
