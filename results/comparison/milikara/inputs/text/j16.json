{
  "song": "j16",
  "name": "j16 - To Unseal",
  "audio": "datasets/audio/j16 - To Unseal.m4a",
  "lines": [
    {
      "id": "j16-n630",
      "text": "何か奪い 得たとして"
    },
    {
      "id": "j16-n651",
      "text": "それで満たされてく夢？"
    },
    {
      "id": "j16-n670",
      "text": "荒廃する 世界ごと"
    },
    {
      "id": "j16-n694",
      "text": "逆転への Will"
    },
    {
      "id": "j16-n708",
      "text": "Just believe 強く"
    },
    {
      "id": "j16-n718",
      "text": "想いを貫き"
    },
    {
      "id": "j16-n733",
      "text": "歩んできた絆を…今！"
    },
    {
      "id": "j16-n756",
      "text": "手離せない"
    },
    {
      "id": "j16-n769",
      "text": "手離さない"
    },
    {
      "id": "j16-n782",
      "text": "ミライ"
    },
    {
      "id": "j16-n786",
      "text": "完璧な 理想よりも"
    },
    {
      "id": "j16-n810",
      "text": "熱く 響かせ"
    },
    {
      "id": "j16-n824",
      "text": "滅びが示す"
    },
    {
      "id": "j16-n838",
      "text": "1000年先の世界だと知っても"
    },
    {
      "id": "j16-n873",
      "text": "人から人へと"
    },
    {
      "id": "j16-n888",
      "text": "紡いでいくもの"
    },
    {
      "id": "j16-n900",
      "text": "信念に誓う"
    },
    {
      "id": "j16-n921",
      "text": "生きることを諦めないで"
    },
    {
      "id": "j16-n941",
      "text": "独りじゃないと"
    },
    {
      "id": "j16-n952",
      "text": "この歌から 証明してく"
    },
    {
      "id": "j16-n975",
      "text": "繋がる手を取って…"
    },
    {
      "id": "j16-n995",
      "text": "抜け出せない絶望が"
    },
    {
      "id": "j16-n1019",
      "text": "真逆の意志を襲う"
    },
    {
      "id": "j16-n1043",
      "text": "たった一つ 揺るがない"
    },
    {
      "id": "j16-n1061",
      "text": "涙の意味は？"
    },
    {
      "id": "j16-n1079",
      "text": "Just believe いつか"
    },
    {
      "id": "j16-n1086",
      "text": "笑い合う為に"
    },
    {
      "id": "j16-n1104",
      "text": "誰かがまた 愛を照らす"
    },
    {
      "id": "j16-n1126",
      "text": "繰り返して"
    },
    {
      "id": "j16-n1139",
      "text": "繰り返した"
    },
    {
      "id": "j16-n1152",
      "text": "正義…"
    },
    {
      "id": "j16-n1163",
      "text": "制御不能"
    },
    {
      "id": "j16-n1182",
      "text": "振りかざして"
    },
    {
      "id": "j16-n1192",
      "text": "もう止められない"
    },
    {
      "id": "j16-n1204",
      "text": "封鎖された"
    },
    {
      "id": "j16-n1217",
      "text": "1000年先の愚かな世界でも"
    },
    {
      "id": "j16-n1252",
      "text": "人は人を想い"
    },
    {
      "id": "j16-n1271",
      "text": "手を差し伸べてく"
    },
    {
      "id": "j16-n1289",
      "text": "何より固い"
    },
    {
      "id": "j16-n1306",
      "text": "生きることが"
    },
    {
      "id": "j16-n1316",
      "text": "罪だと言うなら"
    },
    {
      "id": "j16-n1331",
      "text": "人はどうして 助け合うの"
    },
    {
      "id": "j16-n1354",
      "text": "それがすべての"
    },
    {
      "id": "j16-n1362",
      "text": "ミライへと繋がる"
    },
    {
      "id": "j16-n1375",
      "text": "澄んだ瞳が開いたなら"
    },
    {
      "id": "j16-n1396",
      "text": "Hand in hand to faith"
    },
    {
      "id": "j16-n1402",
      "text": "1000年先、"
    },
    {
      "id": "j16-n1419",
      "text": "その先も夢を忘れないでいて"
    },
    {
      "id": "j16-n1445",
      "text": "人から人へと"
    },
    {
      "id": "j16-n1460",
      "text": "紡いでいくもの"
    },
    {
      "id": "j16-n1472",
      "text": "信念に誓う"
    },
    {
      "id": "j16-n1493",
      "text": "生きることを諦めないで"
    },
    {
      "id": "j16-n1513",
      "text": "独りじゃないと"
    },
    {
      "id": "j16-n1524",
      "text": "この歌から 証明してく"
    },
    {
      "id": "j16-n1547",
      "text": "繋がる手を取って…"
    }
  ]
}
