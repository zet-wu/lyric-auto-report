{
  "song": "y01",
  "name": "y01 - 似是故人来-2003告别演唱会",
  "audio": "datasets/audio/y01 - 似是故人来-2003告别演唱会.m4a",
  "lines": [
    {
      "id": "y01-n41",
      "text": "大家都係似乎鍾意我着旗袍啊"
    },
    {
      "id": "y01-n94",
      "text": "啊做歌星真係開心啊 真係"
    },
    {
      "id": "y01-n139",
      "text": "尤其是 得到你哋嘅愛咧"
    },
    {
      "id": "y01-n180",
      "text": "真係開心啊"
    },
    {
      "id": "y01-n201",
      "text": "而家咧我哋已經唔係歌手同歌迷之間"
    },
    {
      "id": "y01-n266",
      "text": "而家我係全部當你哋都係我啲好好嘅老朋友"
    },
    {
      "id": "y01-n343",
      "text": "因為我諗我哋識咗都起碼十幾年啦啊"
    },
    {
      "id": "y01-n408",
      "text": "如果唔係點稱得上係 老朋友"
    },
    {
      "id": "y01-n457",
      "text": "所以落嚟呢一歌個話咧"
    },
    {
      "id": "y01-n498",
      "text": "我會真嘅送畀我啲"
    },
    {
      "id": "y01-n531",
      "text": "好、好、好、好嘅歌迷 你哋"
    },
    {
      "id": "y01-n571",
      "text": "adding 我嘅 old friends"
    },
    {
      "id": "y01-n584",
      "text": "歌名叫做 似是故人來"
    },
    {
      "id": "y01-n621",
      "text": "同是過路 同做過夢"
    },
    {
      "id": "y01-n654",
      "text": "本應是一對"
    },
    {
      "id": "y01-n675",
      "text": "人在少年 夢中不覺"
    },
    {
      "id": "y01-n708",
      "text": "醒後要歸去"
    },
    {
      "id": "y01-n729",
      "text": "三餐一宿 也共一雙"
    },
    {
      "id": "y01-n762",
      "text": "到底會是誰"
    },
    {
      "id": "y01-n783",
      "text": "但凡未得到 但凡是過去"
    },
    {
      "id": "y01-n824",
      "text": "總是最登對"
    },
    {
      "id": "y01-n845",
      "text": "台下你望 台上我做"
    },
    {
      "id": "y01-n878",
      "text": "你想做的戲"
    },
    {
      "id": "y01-n899",
      "text": "前事故人 忘憂的你"
    },
    {
      "id": "y01-n932",
      "text": "可曾記得起"
    },
    {
      "id": "y01-n953",
      "text": "歡喜傷悲 老病生死"
    },
    {
      "id": "y01-n986",
      "text": "説不上傳奇"
    },
    {
      "id": "y01-n1007",
      "text": "恨台上卿卿 或台下我我"
    },
    {
      "id": "y01-n1048",
      "text": "不是我跟你"
    },
    {
      "id": "y01-n1069",
      "text": "俗塵渺渺 天意茫茫"
    },
    {
      "id": "y01-n1102",
      "text": "將你共我分開"
    },
    {
      "id": "y01-n1127",
      "text": "斷腸字點點 風雨聲連連"
    },
    {
      "id": "y01-n1168",
      "text": "似是故人來"
    },
    {
      "id": "y01-n1189",
      "text": "何日再在 何地再聚"
    },
    {
      "id": "y01-n1222",
      "text": "説今夜眞暖"
    },
    {
      "id": "y01-n1243",
      "text": "無份有緣 回憶不斷"
    },
    {
      "id": "y01-n1276",
      "text": "生命却苦短"
    },
    {
      "id": "y01-n1297",
      "text": "一種相思 兩段苦戀"
    },
    {
      "id": "y01-n1330",
      "text": "半生説沒完"
    },
    {
      "id": "y01-n1351",
      "text": "在年月深淵 望明月遠遠"
    },
    {
      "id": "y01-n1392",
      "text": "想像你幽怨"
    },
    {
      "id": "y01-n1413",
      "text": "俗塵渺渺 天意茫茫"
    },
    {
      "id": "y01-n1446",
      "text": "將你共我分開"
    },
    {
      "id": "y01-n1471",
      "text": "斷腸字點點 風雨聲連連"
    },
    {
      "id": "y01-n1512",
      "text": "似是故人來"
    },
    {
      "id": "y01-n1533",
      "text": "留下你 或留下我在"
    },
    {
      "id": "y01-n1566",
      "text": "世間上終老"
    },
    {
      "id": "y01-n1587",
      "text": "離別以前 未知相對"
    },
    {
      "id": "y01-n1620",
      "text": "當日那麼好"
    },
    {
      "id": "y01-n1641",
      "text": "執子之手 却又分手"
    },
    {
      "id": "y01-n1674",
      "text": "愛得有還無"
    },
    {
      "id": "y01-n1695",
      "text": "十年後雙雙 萬年後對對"
    },
    {
      "id": "y01-n1736",
      "text": "只恨看不到"
    },
    {
      "id": "y01-n1757",
      "text": "十年後雙雙 萬年後對對"
    },
    {
      "id": "y01-n1798",
      "text": "只恨看不到"
    }
  ]
}
