{
  "song": "s13",
  "name": "骹车破尼-假名注音",
  "audio": "datasets/audio/骹车破尼.m4a",
  "lines": [
    {
      "id": "s13-n54",
      "text": "落雨答滴骹车破尼"
    },
    {
      "id": "s13-n91",
      "text": "牵去修理身顶无钱"
    },
    {
      "id": "s13-n128",
      "text": "爱拍手机佮人借钱"
    },
    {
      "id": "s13-n165",
      "text": "怎知欠费停机"
    },
    {
      "id": "s13-n194",
      "text": "想起昨日我许粒女"
    },
    {
      "id": "s13-n229",
      "text": "骗我感情诈我个钱"
    },
    {
      "id": "s13-n267",
      "text": "呾伊啊父"
    },
    {
      "id": "s13-n285",
      "text": "流血答滴"
    },
    {
      "id": "s13-n305",
      "text": "企在中心医院"
    },
    {
      "id": "s13-n334",
      "text": "积恶死 我真实相信伊"
    },
    {
      "id": "s13-n375",
      "text": "现金硬币存折"
    },
    {
      "id": "s13-n404",
      "text": "通身家产全部分伊"
    },
    {
      "id": "s13-n442",
      "text": "伊挈了走去覕"
    },
    {
      "id": "s13-n469",
      "text": "积恶死 我真是积恶死"
    },
    {
      "id": "s13-n509",
      "text": "通身揣无毫子"
    },
    {
      "id": "s13-n538",
      "text": "了还睹着骹车破尼"
    },
    {
      "id": "s13-n575",
      "text": "我决定从此唔钓女"
    },
    {
