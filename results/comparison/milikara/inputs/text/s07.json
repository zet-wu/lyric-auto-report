{
  "song": "s07",
  "name": "両翼のBrilliance",
  "audio": "datasets/audio/両翼のBrilliance.m4a",
  "lines": [
    {
      "id": "s07-n791",
      "text": "運命は残酷に"
    },
    {
      "id": "s07-n814",
      "text": "明けない夜に"
    },
    {
      "id": "s07-n828",
      "text": "決して夢は曇らずに"
    },
    {
      "id": "s07-n850",
      "text": "救いは正義に"
    },
    {
      "id": "s07-n868",
      "text": "悲しみ断ち切り"
    },
    {
      "id": "s07-n886",
      "text": "負けられない戦いへ"
    },
    {
      "id": "s07-n904",
      "text": "証をかざして"
    },
    {
      "id": "s07-n916",
      "text": "心と"
    },
    {
      "id": "s07-n946",
      "text": "心"
    },
    {
      "id": "s07-n966",
      "text": "純白が導く"
    },
    {
      "id": "s07-n985",
      "text": "舞台は幕を開ける"
    },
    {
      "id": "s07-n1008",
      "text": "Ride on"
    },
    {
      "id": "s07-n1014",
      "text": "Stand up!"
    },
    {
      "id": "s07-n1017",
      "text": "例え僅かな光でも"
    },
    {
      "id": "s07-n1061",
      "text": "最後の最後まで"
    },
    {
      "id": "s07-n1083",
      "text": "手を伸ばし続け"
    },
    {
      "id": "s07-n1101",
      "text": "諦めないと歌うなら"
    },
    {
      "id": "s07-n1120",
      "text": "奇跡は舞い降りるんだ"
    },
    {
      "id": "s07-n1168",
      "text": "私たちの前に"
    },
    {
      "id": "s07-n1184",
      "text": "決意と覚悟の両翼で"
    },
    {
      "id": "s07-n1216",
      "text": "望む未来まで"
    },
    {
      "id": "s07-n1245",
      "text": "羽ばたきは"
    },
    {
      "id": "s07-n1254",
      "text": "勝利をもたらして"
    },
    {
      "id": "s07-n1270",
      "text": "不平等な世界"
    },
    {
      "id": "s07-n1295",
      "text": "揺らぐ灯りに"
    },
    {
      "id": "s07-n1309",
      "text": "できることを精一杯に"
    },
    {
      "id": "s07-n1332",
      "text": "枝葉を渡る"
    },
    {
      "id": "s07-n1349",
      "text": "幾つもの祈りで"
    },
    {
      "id": "s07-n1365",
      "text": "背中を優しく押した"
    },
    {
      "id": "s07-n1389",
      "text": "あなたへの思い"
    },
    {
      "id": "s07-n1401",
      "text": "私と"
    },
    {
      "id": "s07-n1425",
      "text": "私"
    },
    {
      "id": "s07-n1442",
      "text": "どれだけ希望が"
    },
    {
      "id": "s07-n1457",
      "text": "打ち砕かれても"
    },
    {
      "id": "s07-n1472",
      "text": "Attack"
    },
    {
      "id": "s07-n1478",
      "text": "Stand up!"
    },
    {
      "id": "s07-n1481",
      "text": "譲れない願いを掲げ"
    },
    {
      "id": "s07-n1525",
      "text": "輝きはまた強く"
    },
    {
      "id": "s07-n1542",
      "text": "天より降り立つ"
    },
    {
      "id": "s07-n1560",
      "text": "運命を変えるために"
    },
    {
      "id": "s07-n1581",
      "text": "終わらせない私自身"
    },
    {
      "id": "s07-n1631",
      "text": "先導者は翔ける"
    },
    {
      "id": "s07-n1653",
      "text": "振りかざす意思と"
    },
    {
      "id": "s07-n1671",
      "text": "失敗を恐れない勇気"
    },
    {
      "id": "s07-n1710",
      "text": "永遠に色褪せないまま"
    },
    {
      "id": "s07-n1736",
      "text": "あなたのためなら 全部"
    },
    {
      "id": "s07-n1754",
      "text": "なんだって"
    },
    {
      "id": "s07-n1766",
      "text": "信じ続けることで"
    },
    {
      "id": "s07-n1783",
      "text": "痛みの分だけ"
    },
    {
      "id": "s07-n1798",
      "text": "強くなれたんだ"
    },
    {
      "id": "s07-n1810",
      "text": "Turn up"
    },
    {
      "id": "s07-n1816",
      "text": "Stand up!"
    },
    {
      "id": "s07-n1819",
      "text": "どんなに絶望的でも"
    },
    {
      "id": "s07-n1841",
      "text": "最後の最後まで"
    },
    {
      "id": "s07-n1863",
      "text": "叶えてみせるよ"
    },
    {
      "id": "s07-n1875",
      "text": "この眩しさは消えない"
    },
    {
      "id": "s07-n1893",
      "text": "奇跡は私の元へ"
    },
    {
      "id": "s07-n1941",
      "text": "始まる運命に"
    },
    {
      "id": "s07-n1960",
      "text": "決意と覚悟の両翼で"
    },
    {
      "id": "s07-n1992",
      "text": "望む未来まで"
    },
    {
      "id": "s07-n2021",
      "text": "羽ばたきは"
    },
    {
      "id": "s07-n2030",
      "text": "勝利をもたらして"
    }
  ]
}
