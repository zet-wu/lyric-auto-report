{
  "song": "s10",
  "name": "恋桜開花前線",
  "audio": "datasets/audio/恋桜開花前線.m4a",
  "lines": [
    {
      "id": "s10-n64",
      "text": "小さく深呼吸して"
    },
    {
      "id": "s10-n88",
      "text": "通学路あなたを待つ"
    },
    {
      "id": "s10-n112",
      "text": "まだかな?もうすぐ?"
    },
    {
      "id": "s10-n123",
      "text": "時計ばかりを見てる"
    },
    {
      "id": "s10-n143",
      "text": "足音聞こえるたび"
    },
    {
      "id": "s10-n163",
      "text": "鞄持つ手が震えた"
    },
    {
      "id": "s10-n187",
      "text": "大きな木の下"
    },
    {
      "id": "s10-n205",
      "text": "蕾のような恋"
    },
    {
      "id": "s10-n221",
      "text": "目を見ればドキドキします"
    },
    {
      "id": "s10-n240",
      "text": "顔上げて挨拶したいのに"
    },
    {
      "id": "s10-n267",
      "text": "なんでだろう"
    },
    {
      "id": "s10-n274",
      "text": "いつもできてること"
    },
    {
      "id": "s10-n284",
      "text": "不器用になってく"
    },
    {
      "id": "s10-n303",
      "text": "自転車に乗って行こう"
    },
    {
      "id": "s10-n330",
      "text": "この道"
    },
    {
      "id": "s10-n338",
      "text": "開花前線は恋の桜"
    },
    {
      "id": "s10-n371",
      "text": "この気持ち"
    },
    {
      "id": "s10-n383",
      "text": "どちらが先に咲かせるか"
    },
    {
      "id": "s10-n402",
      "text": "私だけの勝負です"
    },
    {
      "id": "s10-n423",
      "text": "初めて出会ったのは"
    },
    {
      "id": "s10-n443",
      "text": "まだ少し寒い季節"
    },
    {
      "id": "s10-n467",
      "text": "偶然?必然?"
    },
    {
      "id": "s10-n490",
      "text": "それとも運命なの?"
    },
    {
      "id": "s10-n508",
      "text": "ケンカばかりしていた"
    },
    {
      "id": "s10-n519",
      "text": "つまり正面衝突"
    },
    {
      "id": "s10-n543",
      "text": "素直になれない"
    },
    {
      "id": "s10-n558",
      "text": "でも目を離せない"
    },
    {
      "id": "s10-n574",
      "text": "いつも意識していた"
    },
    {
      "id": "s10-n591",
      "text": "少しだけ季節過ぎて"
    },
    {
      "id": "s10-n615",
      "text": "二人の関係"
    },
    {
      "id": "s10-n633",
      "text": "相も変わらずの距離"
    },
    {
      "id": "s10-n656",
      "text": "それでもあなたとほら"
    },
    {
      "id": "s10-n667",
      "text": "歩くとき歩幅同じ"
    },
    {
      "id": "s10-n691",
      "text": "どちらが合わせて"
    },
    {
      "id": "s10-n703",
      "text": "いるのか不思議だね"
    },
    {
      "id": "s10-n722",
      "text": "言葉では伝えられない"
    },
    {
      "id": "s10-n744",
      "text": "この想いもう限界なんです"
    },
    {
      "id": "s10-n769",
      "text": "決めました桜咲く頃には"
    },
    {
      "id": "s10-n796",
      "text": "ぶつけます全部"
    },
    {
      "id": "s10-n811",
      "text": "自転車をとめて羽を正した"
    },
    {
      "id": "s10-n842",
      "text": "開花前線はもう満開"
    },
    {
      "id": "s10-n875",
      "text": "それなのに"
    },
    {
      "id": "s10-n881",
      "text": "あなたからの不意打ちきた"
    },
    {
      "id": "s10-n903",
      "text": "ずるいんです"
    },
    {
      "id": "s10-n910",
      "text": "自転車に乗って行こう二人で"
    },
    {
      "id": "s10-n944",
      "text": "開花前線は恋の桜"
    },
    {
      "id": "s10-n977",
      "text": "咲き誇る"
    },
    {
      "id": "s10-n989",
      "text": "この気持ちを背中越しに"
    },
    {
      "id": "s10-n1017",
      "text": "好きですよと伝えた"
    }
  ]
}
