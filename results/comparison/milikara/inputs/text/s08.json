{
  "song": "s08",
  "name": "光陰の海原",
  "audio": "datasets/audio/光陰の海原.m4a",
  "lines": [
    {
      "id": "s08-n419",
      "text": "夜空見上げてここに居てもいいのに"
    },
    {
      "id": "s08-n453",
      "text": "星が瞬き暗い過去が消えてく"
    },
    {
      "id": "s08-n490",
      "text": "光る未来を目指して手を取り合う"
    },
    {
      "id": "s08-n533",
      "text": "今に始まりそうな期待感じてる"
    },
    {
      "id": "s08-n568",
      "text": "沢山の夢を持つのは素敵と"
    },
    {
      "id": "s08-n604",
      "text": "口ずさむ言葉キミとの思い出"
    },
    {
      "id": "s08-n637",
      "text": "扉開けて前を向いて歩くと"
    },
    {
      "id": "s08-n670",
      "text": "金色の砂浜光る風の海原"
    },
    {
      "id": "s08-n715",
      "text": "子供の頃見たプレゼントの様にと"
    },
    {
      "id": "s08-n750",
      "text": "はしゃぐ笑顔のキミを見つめ微笑む"
    },
    {
      "id": "s08-n784",
      "text": "ほどくリボン夢ほどくのはこれから"
    },
    {
      "id": "s08-n806",
      "text": "手を合わせ光るゴールテーブ切ろう"
    },
    {
      "id": "s08-n837",
      "text": "キラキラと 降り注ぐ"
    },
    {
      "id": "s08-n855",
      "text": "宝物 手に集め"
    },
    {
      "id": "s08-n879",
      "text": "広げると 溢れ出す 光の中で"
    },
    {
      "id": "s08-n913",
      "text": "夜空見上げてここに居てもいいのに"
    },
    {
      "id": "s08-n947",
      "text": "星が瞬き暗い過去が消えてく"
    },
    {
      "id": "s08-n984",
