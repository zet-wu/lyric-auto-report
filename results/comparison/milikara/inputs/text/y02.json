  "lines": [
    {
      "id": "y02-n277",
      "text": "未曾后悔"
    },
    {
      "id": "y02-n294",
      "text": "是甘心决定"
    },
    {
      "id": "y02-n315",
      "text": "莫问那可注定"
    },
    {
      "id": "y02-n340",
      "text": "若然是错"
    },
    {
      "id": "y02-n357",
      "text": "从不加理会"
    },
    {
      "id": "y02-n378",
      "text": "命运究竟未明"
    },
    {
      "id": "y02-n403",
      "text": "现实理想难分得清楚"
    },
    {
      "id": "y02-n440",
      "text": "未让两手分开"
    },
    {
      "id": "y02-n465",
      "text": "人生虽短暂"
    },
    {
      "id": "y02-n486",
      "text": "无悔共你"
    },
    {
      "id": "y02-n503",
      "text": "穿梭天边与海岸"
    },
    {
      "id": "y02-n532",
      "text": "重温的景象"
    },
    {
      "id": "y02-n553",
      "text": "零碎渐淡"
    },
    {
      "id": "y02-n570",
      "text": "真心你莫忘记"
    },
    {
      "id": "y02-n595",
      "text": "自由被困"
    },
    {
      "id": "y02-n612",
      "text": "望一一领会"
    },
    {
      "id": "y02-n633",
      "text": "浪漫片刻足够"
    },
    {
      "id": "y02-n658",
      "text": "望原谅我"
    },
    {
      "id": "y02-n675",
      "text": "未给一句话"
    },
    {
      "id": "y02-n696",
      "text": "独自去闯尽头"
    },
    {
      "id": "y02-n721",
      "text": "怒问世间情怎可得瞬间"
    },
    {
      "id": "y02-n762",
      "text": "尽是困忧不息"
    },
    {
      "id": "y02-n787",
      "text": "人生虽短暂"
    },
